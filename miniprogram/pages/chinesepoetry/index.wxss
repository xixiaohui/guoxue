  box-shadow: 0 6rpx 18rpx rgba(47, 79, 62, 0.22);
}

.crossword-entry-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.crossword-entry-char {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFD97D;
  color: #2F4F3E;
  font-size: 40rpx;
  font-weight: 800;
