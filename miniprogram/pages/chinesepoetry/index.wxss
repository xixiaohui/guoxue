  flex-shrink: 0;
}

.entry-hover {
  opacity: 0.9;
  transform: scale(0.99);
}

/* ── 诗词填字入口（青竹配色，与飞花令红卡区分）─── */
.crossword-entry {
  margin: 20rpx 24rpx 0;
  background: linear-gradient(135deg, #2F4F3E, #4A7357 62%, #C4882E 155%);
