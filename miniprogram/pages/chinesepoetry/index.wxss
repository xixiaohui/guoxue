  box-shadow: 0 6rpx 18rpx rgba(47, 79, 62, 0.16);
}

.festival-mid {
  background: linear-gradient(135deg, #1F2A4A, #2C3E66 62%, #C4882E 155%);
}

.festival-duanwu {
