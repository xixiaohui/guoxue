/* pages/chinesepoetry/index.wxss - 诗词天地样式 */
.page {
  background: #F5EDD6;
  min-height: 100vh;
  width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}

/* ── 页头 ─────────────────────────────── */
.page-header {
  background: linear-gradient(160deg, #6B1F0A 0%, #8B2500 55%, #A8381A 100%);
  padding: 40rpx 30rpx 52rpx;
  width: 100%;
  box-sizing: border-box;
}

.header-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #FFF8E7;
  letter-spacing: 6rpx;
}

.header-sub {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 248, 231, 0.65);
  margin-top: 8rpx;
  letter-spacing: 4rpx;
}

/* ── 搜索栏（突出展示 + 数量强调）────────────── */
.search-wrap {
  margin: -24rpx 24rpx 0;
  position: relative;
  z-index: 5;
}

.search-bar {
  background: #FFFBF0;
  border-radius: 20rpx;
  padding: 14rpx 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(139, 37, 0, 0.14);
  border: 1rpx solid #E8C48A;
  width: 100%;
  box-sizing: border-box;
}

.search-inner {
  display: flex;
  align-items: center;
  gap: 10rpx;
  width: 100%;
}

.search-icon {
  font-size: 30rpx;
  flex-shrink: 0;
}

.search-input-area {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.search-input {
  font-size: 28rpx;
  color: #4A2E18;
  min-width: 0;
  height: 40rpx;
  line-height: 40rpx;
  font-weight: 500;
}

.search-input-placeholder {
  font-size: 28rpx;
  color: #B09070;
  font-weight: 500;
}

.search-count {
  font-size: 20rpx;
  color: #C4882E;
  margin-top: 2rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.search-clear {
  font-size: 26rpx;
  color: #B09070;
  padding: 6rpx 8rpx;
  flex-shrink: 0;
}

.search-bar-hover {
  opacity: 0.85;
}

.search-btn {
  background: linear-gradient(90deg, #8B2500, #A8381A);
  border-radius: 20rpx;
  padding: 12rpx 28rpx;
  flex-shrink: 0;
}

.search-btn-hover {
  opacity: 0.8 !important;
}

.search-btn-text {
  font-size: 26rpx;
  color: #FFF8E7;
  font-weight: 600;
}

/* ── 通用区块 ─────────────────────────────── */
.section {
  margin: 28rpx 24rpx 0;
}

.section-head {
  display: flex;
  align-items: center;
  padding: 6rpx 4rpx 18rpx;
}

.label-bar {
  width: 8rpx;
  height: 30rpx;
  background: linear-gradient(180deg, #C4882E, #8B2500);
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.section-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A2E18;
  letter-spacing: 2rpx;
  flex: 1;
}

.section-sub {
  font-size: 20rpx;
  color: #A08C6B;
  letter-spacing: 2rpx;
  padding: 4rpx 0;
}

.section-extra {
  font-size: 24rpx;
  color: #8B2500;
  padding: 6rpx 8rpx;
}

.link-hover {
  opacity: 0.6;
}

/* ── 空态 ─────────────────────────────── */
.empty-tip {
  background: #FFFBF0;
  border: 1rpx dashed #D8C08A;
  border-radius: 16rpx;
  padding: 36rpx 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #8C7B61;
}

/* ── 每日一句卡片 ─────────────────────────────── */
.quote-card {
  margin: 28rpx 24rpx 0;
  background: linear-gradient(150deg, #8B2500, #A8381A 60%, #C4632A);
  border-radius: 24rpx;
  padding: 28rpx 28rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(139, 37, 0, 0.28);
  position: relative;
  overflow: hidden;
}

.quote-card::after {
  content: '';
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255, 220, 150, 0.18), transparent 70%);
}

.quote-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.quote-badge {
  font-size: 22rpx;
  color: #FFD97D;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 217, 125, 0.4);
  border-radius: 20rpx;
  padding: 4rpx 18rpx;
  letter-spacing: 2rpx;
}

.quote-refresh {
  font-size: 22rpx;
  color: rgba(255, 248, 231, 0.8);
  padding: 6rpx 10rpx;
}

.quote-content {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #FFF8E7;
  line-height: 1.7;
  letter-spacing: 2rpx;
  margin-top: 22rpx;
}

.quote-meta {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}

.quote-author {
  font-size: 24rpx;
  color: #FFD97D;
}

.quote-source {
  font-size: 22rpx;
  color: rgba(255, 248, 231, 0.7);
  margin-left: 10rpx;
}

/* ── 诗词海报横幅入口（首页突出展示）─────────────── */
.poster-banner {
  margin: 24rpx 24rpx 0;
  background: linear-gradient(135deg, #FFF3D8 0%, #FBE3B2 55%, #F6D08C 100%);
  border: 1rpx solid #E3B968;
  border-radius: 24rpx;
  padding: 26rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 8rpx 22rpx rgba(196, 136, 46, 0.22);
  position: relative;
  overflow: hidden;
}

.poster-banner::after {
  content: '';
  position: absolute;
  right: -30rpx;
  bottom: -40rpx;
  width: 180rpx;
  height: 180rpx;
  background: radial-gradient(circle, rgba(139, 37, 0, 0.10), transparent 70%);
}

.poster-banner-hover {
  opacity: 0.88;
  transform: scale(0.99);
}

/* 右上角「新」功能角标 */
.poster-banner-new {
  position: absolute;
  top: -2rpx;
  right: -2rpx;
  background: linear-gradient(135deg, #FF5A3C, #D92B1F);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
  padding: 8rpx 14rpx;
  border-radius: 0 24rpx 0 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(217, 43, 31, 0.4);
  z-index: 2;
  letter-spacing: 1rpx;
}

.poster-banner-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.poster-banner-seal {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: linear-gradient(160deg, #8B2500, #B03A1A);
  color: #FFF8E7;
  font-size: 44rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: inset 0 0 0 3rpx rgba(255, 217, 125, 0.55);
}

.poster-banner-info {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.poster-banner-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #5A3208;
  letter-spacing: 2rpx;
}

.poster-banner-sub {
  font-size: 22rpx;
  color: #A0702A;
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}

.poster-banner-btn {
  display: flex;
  align-items: center;
  background: linear-gradient(90deg, #8B2500, #A8381A);
  border-radius: 30rpx;
  padding: 14rpx 28rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(139, 37, 0, 0.28);
}

.poster-banner-btn text {
  font-size: 26rpx;
  font-weight: 600;
  color: #FFF8E7;
  letter-spacing: 1rpx;
}

.poster-banner-arrow {
  margin-left: 6rpx;
  font-size: 30rpx !important;
  line-height: 1;
}

/* ── 搜索板块（突出海量诗词快速检索，深色渐变焦点）── */
.search-panel {
  margin: 20rpx 24rpx 0;
  background: linear-gradient(150deg, #4A1A08 0%, #6B1F0A 45%, #8B2500 100%);
  border-radius: 26rpx;
  padding: 28rpx 28rpx 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(74, 26, 8, 0.32);
  position: relative;
  overflow: hidden;
}

/* 右上角柔光装饰 */
.search-panel-glow {
  position: absolute;
  right: -50rpx;
  top: -60rpx;
  width: 260rpx;
  height: 260rpx;
  background: radial-gradient(circle, rgba(255, 190, 90, 0.22), transparent 70%);
  pointer-events: none;
}

.search-panel-hover {
  opacity: 0.9;
  transform: scale(0.99);
}

.search-panel-top {
  display: flex;
  align-items: center;
}

.search-panel-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: linear-gradient(160deg, rgba(255, 217, 125, 0.28), rgba(255, 180, 70, 0.16));
  border: 1rpx solid rgba(255, 217, 125, 0.5);
  box-shadow: inset 0 0 0 3rpx rgba(255, 217, 125, 0.25);
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.search-panel-head {
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
}

.search-panel-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFF8E7;
  letter-spacing: 2rpx;
}

.search-panel-slogan {
  font-size: 20rpx;
  color: rgba(255, 232, 180, 0.7);
  margin-top: 4rpx;
  letter-spacing: 1rpx;
}

.search-panel-body {
  display: flex;
  flex-direction: column;
  margin-top: 22rpx;
}

.search-panel-num-row {
  display: flex;
  align-items: baseline;
}

.search-panel-num {
  font-size: 68rpx;
  font-weight: 800;
  color: #FFD97D;
  letter-spacing: 2rpx;
  font-variant-numeric: tabular-nums;
  font-family: 'DIN Alternate', 'PingFang SC', sans-serif;
  line-height: 1;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.25);
}

.search-panel-num-unit {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(255, 217, 125, 0.9);
  margin-left: 12rpx;
}

.search-panel-desc {
  font-size: 22rpx;
  color: rgba(255, 248, 231, 0.72);
  margin-top: 12rpx;
  letter-spacing: 1rpx;
}

.search-panel-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  gap: 16rpx;
}

.search-panel-tags {
  display: flex;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
  flex-wrap: wrap;
}

.search-panel-tag {
  font-size: 20rpx;
  color: rgba(255, 232, 180, 0.85);
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 232, 180, 0.3);
  border-radius: 20rpx;
  padding: 6rpx 18rpx;
}

.search-panel-btn {
  display: flex;
  align-items: center;
  background: linear-gradient(90deg, #FFD97D, #FFC24B);
  border-radius: 30rpx;
  padding: 14rpx 30rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.22);
}

.search-panel-btn text {
  font-size: 26rpx;
  font-weight: 700;
  color: #6B1F0A;
  letter-spacing: 1rpx;
}

.search-panel-arrow {
  margin-left: 4rpx;
  font-size: 30rpx !important;
  line-height: 1;
  color: #6B1F0A !important;
}

/* ── 节气卡片 ─────────────────────────────── */
.solar-card {
  margin: 28rpx 24rpx 0;
  background: #FFFBF0;
  border: 1rpx solid #E8C48A;
  border-radius: 24rpx;
  display: flex;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(139, 37, 0, 0.08);
}

.solar-left {
  width: 150rpx;
  background: linear-gradient(160deg, #3E7C4F, #2E6B3F);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  flex-shrink: 0;
}

.solar-term {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFF8E7;
  letter-spacing: 4rpx;
}

.solar-label {
  font-size: 20rpx;
  color: rgba(255, 248, 231, 0.75);
  margin-top: 8rpx;
  letter-spacing: 2rpx;
}

.solar-right {
  flex: 1;
  padding: 22rpx 24rpx;
  min-width: 0;
}

.solar-desc {
  display: block;
  font-size: 24rpx;
  color: #6B5B45;
  line-height: 1.6;
}

.solar-poem {
  margin-top: 14rpx;
  background: #F8EFD9;
  border-left: 6rpx solid #C4882E;
  border-radius: 0 12rpx 12rpx 0;
  padding: 14rpx 18rpx;
}

.solar-poem-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #4A2E18;
}

.solar-poem-preview {
  display: block;
  font-size: 22rpx;
  color: #6B5B45;
  margin-top: 6rpx;
  line-height: 1.5;
}

.solar-go {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8B2500;
}

.solar-go-arrow {
  font-size: 30rpx;
}

/* ── 分类 ─────────────────────────────── */
.chip-block {
  margin-top: 20rpx;
  background: #FFFBF0;
  border: 1rpx solid #E8C48A;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
}

.chip-label {
  font-size: 22rpx;
  color: #8C7B61;
  margin: 4rpx 0 10rpx;
}

.chip-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 12rpx;
}

.chip-row {
  display: inline-flex;
  gap: 14rpx;
  padding-bottom: 4rpx;
}

.chip {
  display: inline-block;
  padding: 10rpx 26rpx;
  background: #F5EDD6;
  border: 1rpx solid #E0C890;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #6B5B45;
  flex-shrink: 0;
}

.chip-active {
  background: linear-gradient(135deg, #8B2500, #A8381A);
  border-color: #8B2500;
  color: #FFF8E7;
  font-weight: 600;
}

.chip-hover {
  opacity: 0.75;
}

/* ── 诗词搜索框（视觉焦点，放大突出）────────── */
.category-search {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #FFFBF0;
  border: 2rpx solid #C4882E;
  border-radius: 20rpx;
  padding: 12rpx 16rpx;
  box-shadow: 0 6rpx 18rpx rgba(196, 136, 46, 0.18);
}

.category-search-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.category-search-input {
  flex: 1;
  min-width: 0;
  height: 60rpx;
  font-size: 28rpx;
  color: #2C1810;
  font-weight: 500;
}

.category-search-placeholder {
  color: #B09070;
  font-size: 26rpx;
}

.category-search-clear {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #EFE3C8;
  color: #8C7B61;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.category-search-btn {
  flex-shrink: 0;
  background: linear-gradient(90deg, #8B2500, #A8381A);
  border-radius: 18rpx;
  padding: 14rpx 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(139, 37, 0, 0.25);
}

.category-search-btn-text {
  font-size: 26rpx;
  color: #FFF8E7;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.category-result {
  margin-top: 18rpx;
}

.category-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 6rpx 4rpx 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #4A2E18;
}

.category-count {
  font-size: 22rpx;
  font-weight: 400;
  color: #8C7B61;
}

/* ── 诗词卡片 ─────────────────────────────── */
.poem-card {
  background: #FFFBF0;
  border: 1rpx solid #E8D5A3;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 2rpx 10rpx rgba(139, 37, 0, 0.05);
}

.card-hover {
  background: #F8EFD9 !important;
  transform: translateY(2rpx);
}

.poem-card-top {
  display: flex;
  align-items: center;
}

.poem-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A2E18;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.poem-type {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #8B2500;
  background: #F8EFD9;
  border: 1rpx solid #E0C890;
  border-radius: 18rpx;
  padding: 2rpx 14rpx;
  margin-left: 12rpx;
}

.poem-author {
  display: block;
  font-size: 24rpx;
  color: #C4882E;
  margin-top: 8rpx;
}

.poem-preview {
  display: block;
  font-size: 24rpx;
  color: #6B5B45;
  margin-top: 10rpx;
  line-height: 1.6;
}

.poem-loading {
  background: #FFFBF0;
  border: 1rpx dashed #D8C08A;
  border-radius: 16rpx;
  padding: 30rpx;
  text-align: center;
}

.poem-loading-text {
  font-size: 24rpx;
  color: #8C7B61;
}

.load-more {
  background: #FFFBF0;
  border: 1rpx solid #E8D5A3;
  border-radius: 16rpx;
  padding: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #8B2500;
}

/* ── 推荐理由 ─────────────────────────────── */
.recommend-reason {
  background: #F8EFD9;
  border-radius: 14rpx;
  padding: 14rpx 20rpx;
  margin-bottom: 16rpx;
}

.recommend-reason-text {
  font-size: 24rpx;
  color: #8B2500;
  letter-spacing: 1rpx;
}

/* ── 诗人风采 ─────────────────────────────── */
.author-scroll {
  width: 100%;
  white-space: nowrap;
}

.author-row {
  display: inline-flex;
  gap: 18rpx;
  padding-bottom: 6rpx;
}

.author-card {
  width: 200rpx;
  background: #FFFBF0;
  border: 1rpx solid #E8D5A3;
  border-radius: 20rpx;
  padding: 26rpx 16rpx;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.author-hover {
  background: #F8EFD9 !important;
  transform: translateY(2rpx);
}

.author-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #C4882E, #8B2500);
  color: #FFF8E7;
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.author-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #4A2E18;
  margin-top: 14rpx;
}

.author-dynasty {
  font-size: 20rpx;
  color: #8C7B61;
  margin-top: 6rpx;
}

/* ── 全部内容（诗词/诗人/朝代/体裁 列表入口）────── */
.entry-grid {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.entry-card {
  width: 100%;
  box-sizing: border-box;
  background: #FFFBF0;
  border: 1rpx solid #E8D5A3;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(139, 37, 0, 0.05);
  position: relative;
  overflow: hidden;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0 20rpx;
}

/* 卡片左侧主题色竖条（每个入口不同色系） */
.entry-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: linear-gradient(180deg, #C4882E, #8B2500);
  pointer-events: none;
}

.entry-authors::before {
  background: linear-gradient(180deg, #6AA07F, #2E6B3F);
}

.entry-dynasties::before {
  background: linear-gradient(180deg, #C4632A, #6B1F0A);
}

.entry-types::before {
  background: linear-gradient(180deg, #7A8BC8, #3B4670);
}

/* 右上角柔和光晕装饰（每个入口不同色系） */
.entry-poems::after,
.entry-authors::after,
.entry-dynasties::after,
.entry-types::after {
  content: '';
  position: absolute;
  right: -30rpx;
  top: -30rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(196, 136, 46, 0.14), transparent 70%);
  pointer-events: none;
}

.entry-authors::after {
  background: radial-gradient(circle, rgba(62, 124, 79, 0.14), transparent 70%);
}

.entry-dynasties::after {
  background: radial-gradient(circle, rgba(139, 37, 0, 0.12), transparent 70%);
}

.entry-types::after {
  background: radial-gradient(circle, rgba(90, 105, 160, 0.14), transparent 70%);
}

.entry-card-top {
  flex-basis: 100%;
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

/* 古风单字印章图标（与主题色同色系） */
.entry-seal {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #C4882E, #8B2500);
  color: #FFF8E7;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 2rpx 6rpx rgba(139, 37, 0, 0.22);
}

.seal-poems {
  background: linear-gradient(135deg, #C4882E, #8B2500);
}

.seal-authors {
  background: linear-gradient(135deg, #3E7C4F, #2E6B3F);
}

.seal-dynasties {
  background: linear-gradient(135deg, #A8381A, #6B1F0A);
}

.seal-types {
  background: linear-gradient(135deg, #5A69A0, #3B4670);
}

/* ── 唐诗/宋词专页卡片专属样式 ─────────────── */
/* 唐诗：唐代朱红印章 + 浓郁暖色主题 */
.entry-tang::before {
  background: linear-gradient(180deg, #D9533A, #8B2500);
}

.entry-tang::after {
  background: radial-gradient(circle, rgba(217, 83, 58, 0.16), transparent 70%);
}

.seal-tang {
  background: linear-gradient(160deg, #C0331F, #8B2500);
  box-shadow: inset 0 0 0 3rpx rgba(255, 217, 125, 0.5), 0 2rpx 6rpx rgba(139, 37, 0, 0.3);
}

/* 宋词：青黛印章 + 清雅蓝紫主题 */
.entry-song::before {
  background: linear-gradient(180deg, #7A8BC8, #3B4670);
}

.entry-song::after {
  background: radial-gradient(circle, rgba(90, 105, 160, 0.16), transparent 70%);
}

.seal-song {
  background: linear-gradient(160deg, #6A7BB8, #3B4670);
  box-shadow: inset 0 0 0 3rpx rgba(200, 215, 255, 0.5), 0 2rpx 6rpx rgba(59, 70, 112, 0.3);
}

.entry-card-main {
  flex: 1;
  min-width: 0;
}

.entry-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #4A2E18;
  letter-spacing: 1rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-subtitle {
  display: block;
  font-size: 20rpx;
  color: #A08C6B;
  margin-top: 6rpx;
  letter-spacing: 1rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-card-num {
  flex: 1;
  min-width: 240rpx;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 18rpx;
  white-space: nowrap;
  flex-wrap: nowrap;
}

.entry-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #8B2500;
  line-height: 1.1;
  flex-shrink: 0;
}

/* 分类数据加载中的数字骨架占位 */
.entry-num-skeleton {
  color: transparent;
  background: #E8D5A3;
  border-radius: 10rpx;
  width: 120rpx;
  animation: skeleton-breathe 1.6s ease-in-out infinite;
  flex-shrink: 0;
}

.entry-label {
  font-size: 22rpx;
  color: #8C7B61;
  white-space: nowrap;
  flex-shrink: 0;
}

.entry-tags {
  flex: 1.6;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8rpx;
  margin-top: 18rpx;
  min-height: 34rpx;
}

.entry-tag {
  font-size: 20rpx;
  color: #8B2500;
  background: #F8EFD9;
  border: 1rpx solid #E0C890;
  border-radius: 10rpx;
  padding: 4rpx 12rpx;
}

.entry-tag-more {
  font-size: 18rpx;
  color: #A08C6B;
  padding: 4rpx 2rpx 0;
}

.entry-foot {
  flex-basis: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #E8D5A3;
  font-size: 22rpx;
  color: #C4882E;
  white-space: nowrap;
}

.entry-arrow {
  font-size: 26rpx;
  color: #C4A87C;
  line-height: 1;
}

.entry-hover {
  opacity: 0.85;
  transform: translateY(2rpx);
}

/* ── 页脚 ─────────────────────────────── */
.footer {
  text-align: center;
  font-size: 20rpx;
  color: #A08C6B;
  padding: 36rpx 0 48rpx;
  letter-spacing: 2rpx;
}

/* ── 骨架屏（加载占位，防止动态内容导致页面跳动）────────── */
@keyframes skeleton-breathe {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}

.skeleton {
  background: #E8D5A3;
  border-radius: 8rpx;
  animation: skeleton-breathe 1.6s ease-in-out infinite;
}

.skeleton-line {
  height: 26rpx;
}

.skeleton-w30 { width: 30%; }
.skeleton-w40 { width: 40%; }
.skeleton-w50 { width: 50%; }
.skeleton-w60 { width: 60%; }
.skeleton-w70 { width: 70%; }
.skeleton-w90 { width: 90%; }

.skeleton-mt { margin-top: 16rpx; }

/* 诗词卡片骨架（外层为卡片外观，内部线条呼吸闪烁） */
.skeleton-card {
  background: #FFFBF0;
  border: 1rpx solid #E8D5A3;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 18rpx;
}

.skeleton-chip {
  width: 120rpx;
  height: 56rpx;
  border-radius: 30rpx;
  flex-shrink: 0;
  display: inline-block;
}

.skeleton-circle {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
}

.skeleton-block-solar {
  height: 120rpx;
  border-radius: 12rpx;
}

/* 诗人卡片骨架 */
.skeleton-author {
  width: 200rpx;
  background: #FFFBF0;
  border: 1rpx solid #E8D5A3;
  border-radius: 20rpx;
  padding: 26rpx 16rpx;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

/* 深色卡片（每日一句 / 节气左栏）内的骨架线条用半透明白 */
.quote-card .skeleton,
.solar-left .skeleton {
  background: rgba(255, 248, 231, 0.25);
}

/* 固定最小高度：骨架与真实内容切换时高度更接近，减少跳动 */
.quote-card,
.solar-card {
  min-height: 230rpx;
}

/* ── 飞花令入口 ─────────────────────────── */
.feihua-entry {
  margin: 24rpx 24rpx 0;
  background: linear-gradient(135deg, #8B2500, #A23A12 60%, #C4882E 150%);
  border-radius: 20rpx;
  padding: 22rpx 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 6rpx 18rpx rgba(139, 37, 0, 0.18);
}

.feihua-entry-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.feihua-entry-char {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFD97D;
  color: #8B2500;
  font-size: 40rpx;
  font-weight: 800;
  border-radius: 18rpx;
  flex-shrink: 0;
}

.feihua-entry-info {
