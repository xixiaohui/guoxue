/* pages/chinesepoetry_detail/index.wxss - 诗词/诗人详情页样式 */
.page {
  background: #F5EDD6;
  min-height: 100vh;
  width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
  padding-bottom: 160rpx;
}

/* ── 顶部标题区 ─────────────────────────────── */
.hero {
  background: linear-gradient(160deg, #6B1F0A 0%, #8B2500 55%, #A8381A 100%);
  padding: 44rpx 40rpx 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
}

.hero::after {
  content: '';
  position: absolute;
  right: -60rpx;
  top: -60rpx;
  width: 260rpx;
  height: 260rpx;
  background: radial-gradient(circle, rgba(255, 220, 150, 0.16), transparent 70%);
}

.hero-kind {
  font-size: 20rpx;
  color: #FFD97D;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 217, 125, 0.4);
  border-radius: 20rpx;
  padding: 4rpx 20rpx;
  letter-spacing: 4rpx;
}

.hero-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #FFF8E7;
  letter-spacing: 3rpx;
  margin-top: 20rpx;
  text-align: center;
}

.hero-meta {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  gap: 12rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.meta-item {
  font-size: 24rpx;
  color: rgba(255, 248, 231, 0.85);
  background: rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  padding: 4rpx 18rpx;
}

.seed-tip {
  margin-top: 16rpx;
  font-size: 20rpx;
  color: rgba(255, 248, 231, 0.55);
  text-align: center;
}

/* 朋友圈单页模式提示（落地页无登录态/存储隔离） */
.single-page-tip {
  margin: 26rpx 24rpx 0;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(139, 37, 0, 0.05);
  border: 1rpx dashed rgba(139, 37, 0, 0.22);
  text-align: center;
}

.single-page-tip-text {
  font-size: 22rpx;
  color: #8B2500;
  letter-spacing: 1rpx;
}

/* ── 诗词正文 ─────────────────────────────── */
.content-card {
  margin: 26rpx 24rpx 0;
  background: #FFFBF0;
  border: 1rpx solid #E8D5A3;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(139, 37, 0, 0.06);
}

.content-inner {
  padding: 40rpx 36rpx;
  background:
    repeating-linear-gradient(transparent, transparent 76rpx, #F0E3C0 76rpx, #F0E3C0 78rpx);
  border-radius: 20rpx;
}

.poem-content {
  font-size: 32rpx;
  color: #4A2E18;
  line-height: 78rpx;
  letter-spacing: 2rpx;
  white-space: pre-wrap;
  display: block;
}

/* 正文缺失空态（分享落地且在线补全失败时展示） */
.content-missing {
  padding: 64rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 14rpx;
}

.content-missing-icon {
  font-size: 64rpx;
}

.content-missing-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #4A2E18;
  letter-spacing: 2rpx;
}

.content-missing-desc {
  font-size: 24rpx;
  color: #8C7B61;
  line-height: 1.7;
}

/* ── 诗词信息块（朝代/体裁/作者/名句） ─────────── */
.info-card {
  margin: 26rpx 24rpx 0;
  background: #FFFBF0;
  border: 1rpx solid #E8D5A3;
  border-radius: 20rpx;
  padding: 26rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(139, 37, 0, 0.06);
}

.info-row {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
}

.info-label {
  flex-shrink: 0;
  width: 96rpx;
  font-size: 24rpx;
  color: #8C7B61;
  letter-spacing: 2rpx;
}

.info-value {
  flex: 1;
  font-size: 26rpx;
  color: #4A2E18;
  line-height: 1.7;
}

/* ── 搜一搜直达引导 ─────────────────────────── */
.search-hint {
  margin: 22rpx 24rpx 0;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(139, 37, 0, 0.06);
  border: 1rpx dashed rgba(139, 37, 0, 0.25);
  text-align: center;
}

.search-hint-text {
  font-size: 22rpx;
  color: #8B2500;
  letter-spacing: 1rpx;
}

/* ── 诗人介绍 ─────────────────────────────── */
.author-card {
  margin: 26rpx 24rpx 0;
  background: #FFFBF0;
  border: 1rpx solid #E8D5A3;
  border-radius: 20rpx;
  padding: 34rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(139, 37, 0, 0.06);
}

.author-top {
  display: flex;
  align-items: center;
}

.author-avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #C4882E, #8B2500);
  color: #FFF8E7;
  font-size: 48rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.author-info {
  margin-left: 24rpx;
  min-width: 0;
}

.author-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #4A2E18;
}

.author-dynasty {
  display: block;
  font-size: 24rpx;
  color: #8C7B61;
  margin-top: 8rpx;
}

.author-divider {
  height: 1rpx;
  background: #E8D5A3;
  margin: 24rpx 0;
}

.author-desc {
  display: block;
  font-size: 26rpx;
  color: #6B5B45;
  line-height: 1.8;
  letter-spacing: 1rpx;
}

/* ── 诗人全部诗词（分页列表）───────────────── */
.author-poems {
  margin: 26rpx 24rpx 0;
}

.poem-section-head {
  display: flex;
  align-items: center;
  padding: 6rpx 4rpx 18rpx;
}

.poem-label-bar {
  width: 8rpx;
  height: 30rpx;
  background: linear-gradient(180deg, #C4882E, #8B2500);
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.poem-section-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A2E18;
  letter-spacing: 2rpx;
  flex: 1;
}

.poem-section-count {
  font-size: 22rpx;
  color: #8C7B61;
}

.poem-card {
  background: #FFFBF0;
  border: 1rpx solid #E8D5A3;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 2rpx 10rpx rgba(139, 37, 0, 0.05);
}

.card-hover {
  background: #F8EFD9 !important;
  transform: translateY(2rpx);
}

.poem-card-top {
  display: flex;
  align-items: center;
}

.poem-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A2E18;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.poem-type {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #8B2500;
  background: #F8EFD9;
  border: 1rpx solid #E0C890;
  border-radius: 18rpx;
  padding: 2rpx 14rpx;
  margin-left: 12rpx;
}

.poem-author {
  display: block;
  font-size: 24rpx;
  color: #C4882E;
  margin-top: 8rpx;
}

.poem-preview {
  display: block;
  font-size: 24rpx;
  color: #6B5B45;
  margin-top: 10rpx;
  line-height: 1.6;
}

.poem-loading {
  background: #FFFBF0;
  border: 1rpx dashed #D8C08A;
  border-radius: 16rpx;
  padding: 30rpx;
  text-align: center;
}

.poem-loading-text {
  font-size: 24rpx;
  color: #8C7B61;
}

.load-more {
  background: #FFFBF0;
  border: 1rpx solid #E8D5A3;
  border-radius: 16rpx;
  padding: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #8B2500;
}

.poem-end {
  padding: 22rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: #A08C6B;
  letter-spacing: 2rpx;
}

.empty-tip {
  background: #FFFBF0;
  border: 1rpx dashed #D8C08A;
  border-radius: 16rpx;
  padding: 36rpx 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #8C7B61;
}

/* ── 操作栏 ─────────────────────────────── */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFBF0;
  border-top: 1rpx solid #E8D5A3;
  display: flex;
  padding: 16rpx 40rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(139, 37, 0, 0.08);
  z-index: 10;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 76rpx;
  border-radius: 38rpx;
  margin: 0 10rpx;
}

.action-btn:first-child {
  background: #F8EFD9;
  border: 1rpx solid #E0C890;
}

.action-btn:nth-child(2) {
  background: linear-gradient(90deg, #C4882E, #D99A3D);
}

.action-btn:nth-child(3) {
  background: linear-gradient(90deg, #2E6B5C, #20584A);
}

.action-btn:nth-child(4) {
  background: linear-gradient(90deg, #5A69A0, #3B4670);
}

.action-btn:last-child {
  background: linear-gradient(90deg, #8B2500, #A8381A);
}

/* 点赞按钮（第一个，浅色；已赞变红） */
.like-btn {
  background: #F8EFD9;
  border: 1rpx solid #E0C890;
}

.action-btn.like-btn-active {
  background: linear-gradient(90deg, #E05858, #C03030);
  border: none;
}

.action-btn.like-btn-active .action-icon,
.action-btn.like-btn-active .action-text {
  color: #FFF8E7;
}

.action-hover {
  opacity: 0.85;
}

.action-icon {
  font-size: 30rpx;
  color: #4A2E18;
}

.action-text {
  font-size: 26rpx;
  color: #4A2E18;
  font-weight: 500;
}

.action-btn:nth-child(2) .action-icon,
.action-btn:nth-child(2) .action-text,
.action-btn:nth-child(3) .action-icon,
.action-btn:nth-child(3) .action-text,
.action-btn:nth-child(4) .action-icon,
.action-btn:nth-child(4) .action-text,
.action-btn:last-child .action-icon,
.action-btn:last-child .action-text {
  color: #FFF8E7;
}

/* ── 页脚 ─────────────────────────────── */
.footer {
  text-align: center;
  font-size: 20rpx;
  color: #A08C6B;
  padding: 36rpx 0 24rpx;
  letter-spacing: 2rpx;
}

/* ── 海报 ─────────────────────────────── */
.poster-canvas {
  position: fixed;
  left: -2000rpx;
  top: 0;
  width: 750rpx;
  height: 1200rpx;
  pointer-events: none;
}

.poster-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(20, 10, 5, 0.7);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
  box-sizing: border-box;
}

.poster-panel {
  width: 100%;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 长海报：内容全部展示，高度动态，超出屏幕可滚动查看（下方预留字体条空间） */
.poster-scroll {
  width: 100%;
  max-height: calc(88vh - 210rpx);
  border-radius: 16rpx;
  overflow: hidden;
}

.poster-loading {
  background: rgba(255, 251, 240, 0.96);
  border-radius: 20rpx;
  width: 100%;
  padding: 80rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.poster-loading-icon {
  font-size: 64rpx;
  animation: poster-swing 1.4s infinite;
}

.poster-loading-text {
  font-size: 26rpx;
  color: #8C7B61;
}

@keyframes poster-swing {
  0%, 100% { transform: rotate(-8deg); }
  50% { transform: rotate(8deg); }
}

.poster-img {
  width: 100%;
  display: block;
  border-radius: 16rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.45);
  overflow: hidden;
}

.poster-btns {
  display: flex;
  width: 100%;
  gap: 24rpx;
  margin-top: 30rpx;
}

.poster-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.poster-btn.save {
  background: linear-gradient(90deg, #C4882E, #D99A3D);
  color: #FFF8E7;
}

.poster-btn.cancel {
  background: rgba(255, 251, 240, 0.16);
  border: 1rpx solid rgba(255, 251, 240, 0.35);
  color: #FFF8E7;
}

.poster-btn-hover {
  opacity: 0.85;
}

/* ── 海报字体选择条（预览页切换字体后本地重绘） ───────────── */
.font-bar {
  width: 100%;
  margin-top: 24rpx;
}

.font-scroll {
  width: 100%;
  white-space: nowrap;
}

.font-chips {
  display: inline-flex;
  gap: 14rpx;
  padding: 4rpx 2rpx;
}

.font-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 251, 240, 0.16);
  border: 1rpx solid rgba(255, 251, 240, 0.35);
}

.font-chip-label {
  font-size: 24rpx;
  line-height: 34rpx;
  color: #FFF8E7;
}

.font-chip-desc {
  font-size: 18rpx;
  line-height: 26rpx;
  color: rgba(255, 248, 231, 0.62);
}

.font-chip-active {
  background: linear-gradient(90deg, #C4882E, #D99A3D);
  border-color: transparent;
}

.font-chip-active .font-chip-label {
  font-weight: 600;
}

.font-chip-active .font-chip-desc {
  color: rgba(255, 248, 231, 0.85);
}

.font-chip-hover {
  opacity: 0.85;
}

.font-tip {
  margin-top: 20rpx;
}

.font-tip-text {
  font-size: 22rpx;
  color: rgba(255, 248, 231, 0.6);
}

/* ── 海报样式选择弹层 ─────────────────────── */
.style-panel {
  width: 100%;
  max-height: 86vh;
  overflow-y: auto;
  background: #FFFBF0;
  border-radius: 28rpx;
  padding: 30rpx 30rpx 40rpx;
  box-sizing: border-box;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.4);
}

.style-head {
  position: relative;
  min-height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 26rpx;
}

.style-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #4A2E18;
  letter-spacing: 4rpx;
}

.style-close {
  position: absolute;
  right: 4rpx;
  top: 0;
  font-size: 32rpx;
  color: #8C7B61;
  padding: 8rpx;
  line-height: 1;
}

.style-card {
  background: #FFFFFF;
  border: 2rpx solid #E8D5A3;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
}

.style-card-active {
  border-color: #C4882E;
  background: #FFF8E7;
  box-shadow: 0 0 0 4rpx rgba(196, 136, 46, 0.12);
}

.style-card-hover {
  opacity: 0.92;
}

.style-card-head {
  display: flex;
  align-items: center;
}

.style-badge {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #FFF8E7;
  background: linear-gradient(135deg, #8B2500, #A8381A);
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
}

.style-badge.theme-badge {
  background: linear-gradient(135deg, #2E6B5C, #20584A);
}

.style-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: #4A2E18;
}

.style-check {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #C4882E, #D99A3D);
  color: #FFF8E7;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.style-desc {
  display: block;
  font-size: 22rpx;
  color: #8C7B61;
  margin-top: 12rpx;
  line-height: 1.5;
}

.style-opt-row {
  display: flex;
  align-items: flex-start;
  padding: 8rpx 4rpx 0;
}

.style-opt-label {
  flex-shrink: 0;
  width: 88rpx;
  font-size: 24rpx;
  color: #8C7B61;
  line-height: 52rpx;
}

.style-chips {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  font-size: 24rpx;
  color: #6B5B45;
  background: #F4EADA;
  border: 1rpx solid #E0C890;
  border-radius: 26rpx;
  padding: 6rpx 26rpx;
}

.chip-active {
  background: linear-gradient(90deg, #C4882E, #D99A3D);
  color: #FFF8E7;
  border-color: transparent;
  font-weight: 600;
}

.style-btn {
  margin-top: 34rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(90deg, #8B2500, #A8381A);
  color: #FFF8E7;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(139, 37, 0, 0.28);
}

.style-btn-hover {
  opacity: 0.9;
}

/* ── 标记诗词来源开关 ─────────────────────── */
.source-mark-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #F4EADA;
  border: 1rpx solid #E0C890;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-top: 8rpx;
}

.source-mark-info {
  flex: 1;
  min-width: 0;
  margin-right: 20rpx;
  display: flex;
  flex-direction: column;
}

.source-mark-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #4A2E18;
}

.source-mark-desc {
  font-size: 20rpx;
  color: #8C7B61;
  line-height: 1.4;
  margin-top: 4rpx;
}

.source-mark-switch {
  flex-shrink: 0;
  width: 88rpx;
  height: 50rpx;
  border-radius: 26rpx;
  background: #D8C9A8;
  position: relative;
  transition: background 0.2s;
}

.source-mark-switch .source-mark-knob {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.18);
  transition: left 0.2s;
}

.source-mark-switch.source-mark-on {
  background: linear-gradient(90deg, #C4882E, #D99A3D);
}

.source-mark-switch.source-mark-on .source-mark-knob {
  left: 42rpx;
}

/* ── 题跋（落款一句话）输入 ─────────────────── */
.seal-caption-row {
  display: flex;
  flex-direction: column;
  margin-top: 8rpx;
}

.seal-caption-label {
  font-size: 24rpx;
  color: #8C7B61;
  margin-bottom: 10rpx;
}

.seal-caption-input {
  width: 100%;
  min-height: 80rpx;
  background: #F4EADA;
  border: 1rpx solid #E0C890;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: #4A2E18;
  line-height: 1.5;
  box-sizing: border-box;
}

.seal-caption-placeholder {
  color: #B8A98C;
}

/* ── 生成海报前登录引导弹层 ─────────────────── */
.login-guide-desc {
  display: block;
  font-size: 24rpx;
  color: #8C7B61;
  line-height: 1.5;
  margin-bottom: 28rpx;
  text-align: center;
}

.login-guide-body {
  display: flex;
  align-items: center;
  padding: 8rpx 4rpx;
}

.guide-avatar-btn {
  flex-shrink: 0;
  width: 128rpx;
  height: 128rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  border-radius: 50%;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
}

.guide-avatar-btn::after {
  border: none;
}

.guide-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #F4EADA;
  border: 3rpx solid #E8D5A3;
  box-sizing: border-box;
}

.guide-avatar-tip {
  position: absolute;
  bottom: -2rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 20rpx;
  color: #8B2500;
  background: #FFF8E7;
  border: 1rpx solid #E8D5A3;
  border-radius: 20rpx;
  padding: 2rpx 16rpx;
  white-space: nowrap;
}

.guide-nickname-wrap {
  flex: 1;
  min-width: 0;
  margin-left: 28rpx;
}

.guide-nickname-input {
  height: 80rpx;
  background: #F4EADA;
  border: 1rpx solid #E0C890;
  border-radius: 40rpx;
  padding: 0 32rpx;
  font-size: 30rpx;
  color: #4A2E18;
  box-sizing: border-box;
}

.guide-nickname-placeholder {
  color: #B8A98C;
}

.guide-login-btn {
  margin-top: 34rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(90deg, #2E6B5C, #20584A);
  color: #FFF8E7;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(32, 88, 74, 0.28);
}
