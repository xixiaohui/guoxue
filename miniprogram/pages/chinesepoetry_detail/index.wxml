<!--pages/chinesepoetry_detail/index.wxml - 诗词/诗人详情页-->
<view class="page {{themeClass}} {{fontSizeClass}} {{fontFamilyClass}}">

  <!-- 顶部标题区 -->
  <view class="hero">
    <view class="hero-kind">{{kind === 'author' ? '诗人' : '诗词'}}</view>
    <text class="hero-title">{{title || (kind === 'author' ? '佚名诗人' : '无题')}}</text>
    <view class="hero-meta">
      <text class="meta-item" wx:if="{{dynasty}}">{{dynasty}}</text>
      <text class="meta-item" wx:if="{{kind === 'poem' && author}}">{{author}}</text>
      <text class="meta-item" wx:if="{{type}}">{{type}}</text>
    </view>
    <view class="seed-tip" wx:if="{{fromSeed && !loading}}">内容来自列表页数据，可能与权威版本略有出入</view>
  </view>

  <!-- 诗词正文 -->
  <view class="content-card" wx:if="{{kind === 'poem'}}">
    <!-- 正文缺失：分享落地时先展示加载态，接口补全失败则给出空态说明 -->
    <block wx:if="{{contentMissing && loading}}">
      <view class="poem-loading">
        <text class="poem-loading-text">正在加载正文…</text>
      </view>
    </block>
    <block wx:elif="{{contentMissing}}">
      <view class="content-missing">
        <text class="content-missing-icon">📜</text>
        <text class="content-missing-title">正文暂缺</text>
        <text class="content-missing-desc">分享链接未携带完整正文，且在线检索暂时失败。打开小程序即可查看全文。</text>
      </view>
    </block>
    <view class="content-inner" wx:else>
      <text class="poem-content {{fontSizeClass}} {{fontFamilyClass}}">{{content}}</text>
    </view>
  </view>

  <!-- 朋友圈单页模式提示（落地页无登录态/存储隔离，引导用户打开小程序体验完整功能） -->
  <view class="single-page-tip" wx:if="{{isSinglePage}}">
    <text class="single-page-tip-text">当前为朋友圈分享预览，打开小程序可体验收藏、点赞、海报等完整功能</text>
  </view>

  <!-- 诗词信息（朝代/体裁/作者/名句，供搜一搜索引与阅读） -->
  <view class="info-card" wx:if="{{kind === 'poem' && poemInfo.length}}">
    <view class="info-row" wx:for="{{poemInfo}}" wx:key="label">
      <text class="info-label">{{item.label}}</text>
      <text class="info-value">{{item.value}}</text>
    </view>
  </view>

  <!-- 搜一搜直达引导（教育用户回搜，形成搜索习惯） -->
  <view class="search-hint" wx:if="{{kind === 'poem' && title}}">
    <text class="search-hint-text">微信搜一搜「{{title}}」，即可直达本诗</text>
  </view>

  <!-- 诗人介绍 -->
  <view class="author-card" wx:if="{{kind === 'author'}}">
    <view class="author-top">
      <view class="author-avatar">{{authorChar}}</view>
      <view class="author-info">
        <text class="author-name">{{title}}</text>
        <text class="author-dynasty">{{dynasty || '诗人'}}{{countText && poemCount ? ' · 共 ' + countText + ' 首' : ''}}</text>
      </view>
    </view>
    <view class="author-divider"></view>
    <text class="author-desc {{fontSizeClass}} {{fontFamilyClass}}">{{description || '暂无详细介绍'}}</text>
  </view>

  <!-- 诗人全部诗词（分页展示，/search?type=author） -->
  <view class="author-poems" wx:if="{{kind === 'author'}}">
    <view class="poem-section-head">
      <view class="poem-label-bar"></view>
      <text class="poem-section-label">全部诗词</text>
      <text class="poem-section-count" wx:if="{{authorPoems.length}}">已展示 {{authorPoems.length}} 首</text>
    </view>

    <view class="poem-loading" wx:if="{{authorPoemsLoading}}">
      <text class="poem-loading-text">正在加载…</text>
    </view>

    <block wx:elif="{{authorPoems.length > 0}}">
      <view class="poem-card" wx:for="{{authorPoems}}" wx:key="id" bindtap="goAuthorPoem"
        data-poem="{{item}}" hover-class="card-hover" hover-stay-time="80">
        <view class="poem-card-top">
          <text class="poem-title">{{item.title || '无题'}}</text>
          <text class="poem-type" wx:if="{{item.type}}">{{item.type}}</text>
        </view>
        <text class="poem-author">{{item.dynasty ? item.dynasty + ' · ' : ''}}{{item.author || '佚名'}}</text>
        <text class="poem-preview">{{item.preview}}</text>
      </view>

      <view class="load-more" wx:if="{{authorPoemsHasMore}}" bindtap="loadMoreAuthorPoems"
        hover-class="card-hover" hover-stay-time="80">
        <text>{{authorPoemsLoadingMore ? '加载中…' : '加载更多 ›'}}</text>
      </view>
      <view class="poem-end" wx:else>
        <text>—— 已展示全部 {{authorPoems.length}} 首 ——</text>
      </view>
    </block>

    <view class="empty-tip" wx:elif="{{authorPoemsLoaded}}">暂未收录该作者诗词，去看看其他诗人吧</view>
  </view>

  <!-- 底部操作栏（单页模式下收藏/点赞/复制/海报/返回等能力被禁用，整体隐藏） -->
  <view class="action-bar" wx:if="{{!isSinglePage}}">
    <view class="action-btn like-btn {{liked ? 'like-btn-active' : ''}}" wx:if="{{kind === 'poem'}}" bindtap="toggleLike" hover-class="action-hover" hover-stay-time="80">
      <text class="action-icon">{{liked ? '♥' : '♡'}}</text>
      <text class="action-text">{{liked ? '已赞' : '点赞'}}</text>
    </view>
    <view class="action-btn" wx:if="{{kind === 'poem'}}" bindtap="toggleFavorite" hover-class="action-hover" hover-stay-time="80">
      <text class="action-icon">{{isFavorited ? '★' : '☆'}}</text>
      <text class="action-text">{{isFavorited ? '已收藏' : '收藏'}}</text>
    </view>
    <view class="action-btn" bindtap="copyContent" hover-class="action-hover" hover-stay-time="80">
      <text class="action-icon">📋</text>
      <text class="action-text">复制</text>
    </view>
    <view class="action-btn" wx:if="{{kind === 'poem'}}" bindtap="createPoster" hover-class="action-hover" hover-stay-time="80">
      <text class="action-icon">🖼</text>
      <text class="action-text">海报</text>
    </view>
    <view class="action-btn" bindtap="goBack" hover-class="action-hover" hover-stay-time="80">
      <text class="action-icon">‹</text>
      <text class="action-text">返回</text>
    </view>
  </view>

  <view class="footer">超然古诗词 · 诗词天地</view>

  <!-- 海报生成画布（移出屏幕，供 Canvas 2D 绘制；单页模式下画布能力被禁用，不渲染） -->
  <canvas type="2d" id="posterCanvas" class="poster-canvas" wx:if="{{!isSinglePage}}"></canvas>

  <!-- 生成海报前的登录引导弹层 -->
  <view class="poster-mask" wx:if="{{showLoginGuide}}" catchtap="closeLoginGuide">
    <view class="style-panel login-guide-panel" catchtap="noop">
      <view class="style-head">
        <text class="style-title">登录后生成专属海报</text>
        <text class="style-close" bindtap="closeLoginGuide">✕</text>
      </view>
      <text class="login-guide-desc">登录并设置头像昵称，海报将展示你的个人信息</text>

      <view class="login-guide-body">
        <button class="guide-avatar-btn" open-type="chooseAvatar"
          bind:chooseavatar="onGuideChooseAvatar" hover-class="avatar-btn-hover" hover-stay-time="60">
          <image class="guide-avatar" src="{{guideAvatar || '/images/avatar.png'}}" mode="aspectFill" />
          <text class="guide-avatar-tip">{{isLogin && guideAvatar ? '换头像' : '选头像'}}</text>
        </button>

        <view class="guide-nickname-wrap">
          <input class="guide-nickname-input" type="nickname"
            value="{{guideNickname}}" placeholder="点击设置昵称" placeholder-class="guide-nickname-placeholder"
            bindinput="onGuideNicknameInput" maxlength="20" />
        </view>
      </view>

      <view class="guide-login-btn" wx:if="{{!isLogin}}" bindtap="onGuideLogin" hover-class="style-btn-hover" hover-stay-time="80">
        {{loginLogging ? '登录中…' : '微信登录'}}
      </view>

      <view class="style-btn" wx:if="{{isLogin}}" bindtap="onGuideConfirm" hover-class="style-btn-hover" hover-stay-time="80">完成并生成海报</view>
    </view>
  </view>

  <!-- 海报样式选择弹层 -->
  <view class="poster-mask" wx:if="{{showStylePicker}}" catchtap="closeStylePicker">
    <view class="style-panel" catchtap="noop">
      <view class="style-head">
        <text class="style-title">选择海报样式</text>
        <text class="style-close" bindtap="closeStylePicker">✕</text>
      </view>

      <view class="style-card {{posterStyle === 1 ? 'style-card-active' : ''}}"
        bindtap="pickPosterStyle" data-style="1" hover-class="style-card-hover" hover-stay-time="80">
        <view class="style-card-head">
          <view class="style-badge">经典</view>
          <text class="style-name">书画经典海报</text>
          <view class="style-check" wx:if="{{posterStyle === 1}}">✓</view>
        </view>
        <text class="style-desc">本地绘制 · 完整正文 + 小程序码，保存后可长按识别进入小程序</text>
      </view>

      <view class="style-card {{posterStyle === 2 ? 'style-card-active' : ''}}"
        bindtap="pickPosterStyle" data-style="2" hover-class="style-card-hover" hover-stay-time="80">
        <view class="style-card-head">
          <view class="style-badge theme-badge">诗画</view>
          <text class="style-name">在线诗画海报</text>
          <view class="style-check" wx:if="{{posterStyle === 2}}">✓</view>
        </view>
        <text class="style-desc">服务端渲染 1080×1440 · 支持水墨 / 落日 / 夜月主题与滤镜</text>
      </view>

      <block wx:if="{{posterStyle === 2}}">
        <view class="style-opt-row">
          <text class="style-opt-label">主题</text>
          <view class="style-chips">
            <view class="chip {{posterTheme === 'ink' ? 'chip-active' : ''}}" bindtap="pickPosterTheme" data-theme="ink">水墨</view>
            <view class="chip {{posterTheme === 'sunset' ? 'chip-active' : ''}}" bindtap="pickPosterTheme" data-theme="sunset">落日</view>
            <view class="chip {{posterTheme === 'night' ? 'chip-active' : ''}}" bindtap="pickPosterTheme" data-theme="night">夜月</view>
          </view>
        </view>
        <view class="style-opt-row">
          <text class="style-opt-label">滤镜</text>
          <view class="style-chips">
            <view class="chip {{posterFilter === 'none' ? 'chip-active' : ''}}" bindtap="pickPosterFilter" data-filter="none">原片</view>
            <view class="chip {{posterFilter === 'sepia' ? 'chip-active' : ''}}" bindtap="pickPosterFilter" data-filter="sepia">复古</view>
            <view class="chip {{posterFilter === 'warm' ? 'chip-active' : ''}}" bindtap="pickPosterFilter" data-filter="warm">暖阳</view>
            <view class="chip {{posterFilter === 'cool' ? 'chip-active' : ''}}" bindtap="pickPosterFilter" data-filter="cool">清冷</view>
            <view class="chip {{posterFilter === 'gray' ? 'chip-active' : ''}}" bindtap="pickPosterFilter" data-filter="gray">黑白</view>
            <view class="chip {{posterFilter === 'vivid' ? 'chip-active' : ''}}" bindtap="pickPosterFilter" data-filter="vivid">明艳</view>
          </view>
        </view>
      </block>

      <!-- 标记诗词来源开关（仅在线诗画海报） -->
      <view class="source-mark-row" wx:if="{{posterStyle === 2}}">
        <view class="source-mark-info">
          <text class="source-mark-label">标记诗词来源</text>
          <text class="source-mark-desc">在海报上展示「诗意源于「超然古诗词」微信小程序」</text>
        </view>
        <view class="source-mark-switch {{showSourceMark ? 'source-mark-on' : ''}}" bindtap="toggleSourceMark" hover-class="style-card-hover" hover-stay-time="80">
          <view class="source-mark-knob"></view>
        </view>
      </view>

      <!-- 显示昵称印章开关（仅在线诗画海报） -->
      <view class="source-mark-row" wx:if="{{posterStyle === 2}}">
        <view class="source-mark-info">
          <text class="source-mark-label">显示昵称印章</text>
          <text class="source-mark-desc">在海报左侧以红色印章展示你的昵称（最多 4 字）</text>
        </view>
        <view class="source-mark-switch {{showNicknameSeal ? 'source-mark-on' : ''}}" bindtap="toggleNicknameSeal" hover-class="style-card-hover" hover-stay-time="80">
          <view class="source-mark-knob"></view>
        </view>
      </view>

      <!-- 题跋（落款文字，最多 140 字）输入，仅在开启昵称印章时显示 -->
      <view class="seal-caption-row" wx:if="{{posterStyle === 2 && showNicknameSeal}}">
        <text class="seal-caption-label">题跋（落款）</text>
        <textarea class="seal-caption-input" value="{{sealCaption}}" bindinput="onSealCaptionInput"
          placeholder="输入题跋文字，最多 140 字，如「某某题于中秋」" placeholder-class="seal-caption-placeholder"
          maxlength="140" auto-height="{{true}}" />
      </view>

      <view class="style-btn" bindtap="confirmPoster" hover-class="style-btn-hover" hover-stay-time="80">生成海报</view>
    </view>
  </view>

  <!-- 海报预览弹层（长海报可上下滚动查看全部内容） -->
  <view class="poster-mask" wx:if="{{showPoster}}" catchtap="closePoster">
    <view class="poster-panel" catchtap="noop">
      <view class="poster-loading" wx:if="{{posterLoading}}">
        <text class="poster-loading-icon">📜</text>
        <text class="poster-loading-text">正在生成海报…</text>
      </view>
      <scroll-view wx:elif="{{posterPath}}" scroll-y class="poster-scroll" show-scrollbar="{{false}}"
        enhanced="{{true}}" bounces="{{false}}">
        <image class="poster-img" src="{{posterPath}}" mode="widthFix" show-menu-by-longpress></image>
      </scroll-view>

      <!-- 字体选择条：切换后本地重绘预览（服务端出图的在线海报字体固定） -->
      <view class="font-bar" wx:if="{{posterPath && !posterFromServer}}">
        <scroll-view scroll-x class="font-scroll" show-scrollbar="{{false}}" enhanced="{{true}}">
          <view class="font-chips">
            <view class="font-chip {{posterFont === item.key ? 'font-chip-active' : ''}}"
              wx:for="{{posterFonts}}" wx:key="key" data-font="{{item.key}}"
              bindtap="pickPosterFont" hover-class="font-chip-hover" hover-stay-time="80">
              <text class="font-chip-label">{{item.label}}</text>
              <text class="font-chip-desc">{{item.desc}}</text>
            </view>
          </view>
        </scroll-view>
      </view>
      <view class="font-tip" wx:elif="{{posterPath && posterFromServer}}">
        <text class="font-tip-text">在线海报由服务端渲染，字体固定</text>
      </view>

      <view class="poster-btns" wx:if="{{posterPath}}">
        <view class="poster-btn save" bindtap="savePoster" hover-class="poster-btn-hover" hover-stay-time="80">保存到相册</view>
        <view class="poster-btn cancel" bindtap="closePoster" hover-class="poster-btn-hover" hover-stay-time="80">关闭</view>
      </view>
    </view>
  </view>
</view>
