.home-page {
    background: #FDF6E3;
    min-height: 100vh;
    width: 100%;
    box-sizing: border-box;
  }

  /* 朋友圈单页模式提示 */
  .single-page-tip {
    margin: 20rpx 24rpx 0;
    padding: 18rpx 24rpx;
    border-radius: 16rpx;
    background: rgba(139, 37, 0, 0.05);
    border: 1rpx dashed rgba(139, 37, 0, 0.22);
    text-align: center;
  }

  .single-page-tip-text {
    font-size: 22rpx;
    color: #8B2500;
    letter-spacing: 1rpx;
  }
  
  /* Hero */
  .hero {
    background: linear-gradient(150deg, #5A1200 0%, #8B2500 55%, #A83500 100%);
    padding: 40rpx 30rpx 52rpx;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    width: 100%;
    box-sizing: border-box;
  }
  
  .hero::after {
    content: '文';
    position: absolute;
    right: -80rpx;
    top: -40rpx;
    font-size: 280rpx;
    color: rgba(255,255,255,.04);
    font-weight: 900;
    line-height: 1;
    pointer-events: none;
  }
  
  .hero-left {
    width: 100rpx;
    height: 100rpx;
    background: rgba(255,248,231,.15);
    border: 2rpx solid rgba(255,248,231,.35);
    border-radius: 24rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 26rpx;
    flex-shrink: 0;
    box-shadow: 0 4rpx 16rpx rgba(0,0,0,.2);
    box-sizing: border-box;
  }
  
  .hero-logo-char {
    font-size: 54rpx;
    color: #FFD97D;
    font-weight: 700;
  }
  
  .hero-right {
    flex: 1;
    min-width: 0;
  }
  
  .hero-title {
    display: block;
    font-size: 42rpx;
    font-weight: 700;
    color: #FFF8E7;
    letter-spacing: 4rpx;
    word-break: break-word;
  }
  
  .hero-sub {
    display: block;
    font-size: 22rpx;
    color: rgba(255,248,231,.65);
    margin-top: 8rpx;
    letter-spacing: 2rpx;
    word-break: break-word;
  }
  
  .hero-deco {
    position: absolute;
    bottom: 16rpx;
    right: 28rpx;
    font-size: 20rpx;
    color: rgba(255,248,231,.35);
    letter-spacing: 4rpx;
    font-style: italic;
    white-space: nowrap;
  }
  
  /* Section */
  .section {
    margin-top: 32rpx;
    width: 100%;
    box-sizing: border-box;
  }
  
  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24rpx 16rpx;
    width: 100%;
    box-sizing: border-box;
  }
  
  .section-label-wrap {
    display: flex;
    align-items: center;
    gap: 12rpx;
    min-width: 0;
  }
  
  .label-bar {
    width: 6rpx;
    height: 30rpx;
    background: linear-gradient(180deg, #C4882E, #8B2500);
    border-radius: 3rpx;
    flex-shrink: 0;
  }
  
  .section-label {
    font-size: 30rpx;
    font-weight: 600;
    color: #2C1810;
  }

  .section-sub {
    font-size: 20rpx;
    color: #A08C6B;
    letter-spacing: 2rpx;
    padding: 4rpx 0;
    flex-shrink: 0;
  }
  
  .head-actions {
    display: flex;
    align-items: center;
    gap: 12rpx;
    flex-shrink: 0;
  }
  
  .action-pill,
  .share-pill {
    display: flex;
    align-items: center;
    gap: 6rpx;
    border: 1.5rpx solid #C4882E;
    border-radius: 28rpx;
    padding: 7rpx 18rpx;
    background: #FFFBF0;
    white-space: nowrap;
    box-sizing: border-box;
  }
  
  .pill-icon {
    font-size: 24rpx;
    color: #C4882E;
    line-height: 1;
    flex-shrink: 0;
  }
  
  .pill-text {
    font-size: 23rpx;
    color: #C4882E;
  }
  
  .pill-hover {
    background: #FFF0CC !important;
  }
  
  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  
  .pill-spinning .pill-icon {
    display: inline-block;
    animation: spin 0.5s linear;
  }
  
  /* Daily card */
  .daily-card {
    background: linear-gradient(145deg, #FFFDF4 0%, #FFF8DC 60%, #FFF2C0 100%);
    border-radius: 22rpx;
    margin: 0 24rpx;
    padding: 30rpx 28rpx 24rpx;
    border: 1rpx solid #EDD9A3;
    box-shadow: 0 8rpx 28rpx rgba(139,37,0,.1), 0 2rpx 6rpx rgba(139,37,0,.06);
    position: relative;
    overflow: hidden;
    transition: opacity 0.3s ease, transform 0.3s ease;
    width: calc(100% - 48rpx);
    box-sizing: border-box;
  }
  
  .daily-card::before {
    content: '詩';
    position: absolute;
    right: -40rpx;
    bottom: -40rpx;
    font-size: 170rpx;
    color: rgba(196,136,46,.05);
    font-weight: 900;
    line-height: 1;
    pointer-events: none;
  }
  
  .card-fade {
    opacity: 0.25 !important;
  }
  
  .card-hover {
    transform: scale(0.99);
    opacity: 0.94 !important;
  }
  
  /* Skeleton */
  .skeleton-card {
    animation: shimmer 1.5s infinite;
  }
  
  @keyframes shimmer {
    0%, 100% { opacity: 1; }
    50% { opacity: .5; }
  }
  
  .sk-line {
    background: linear-gradient(90deg, #EDD9A3, #F5E8C0, #EDD9A3);
    border-radius: 6rpx;
  }
  
  .sk-w100 { width: 100%; }
  .sk-w90 { width: 90%; }
  .sk-w85 { width: 85%; }
  .sk-w80 { width: 80%; }
  .sk-w60 { width: 60%; }
  .sk-w40 { width: 40%; }
  
  .sk-h36 { height: 36rpx; }
  .sk-h28 { height: 28rpx; }
  .sk-h22 { height: 22rpx; }
  
  .sk-mb18 { margin-bottom: 18rpx; }
  .sk-mb16 { margin-bottom: 16rpx; }
  .sk-mb10 { margin-bottom: 10rpx; }
  .sk-mb8 { margin-bottom: 8rpx; }
  
  .sk-divider {
    height: 1rpx;
    background: #EDD9A3;
    margin: 18rpx 0;
  }
  
  .daily-badge {
    display: inline-flex;
    align-items: center;
    background: linear-gradient(90deg, #8B2500, #C4882E);
    color: #FFF8E7;
    font-size: 21rpx;
    padding: 5rpx 18rpx;
    border-radius: 20rpx;
    margin-bottom: 20rpx;
    font-weight: 500;
    letter-spacing: 2rpx;
    box-shadow: 0 2rpx 8rpx rgba(139,37,0,.2);
    white-space: nowrap;
  }
  
  .daily-quote-row {
    display: flex;
    align-items: flex-start;
    margin-bottom: 14rpx;
    gap: 4rpx;
    width: 100%;
    box-sizing: border-box;
  }
  
  .q-mark {
    font-size: 44rpx;
    color: #C4882E;
    line-height: 1.2;
    font-weight: 700;
    flex-shrink: 0;
  }
  
  .q-open {
    margin-top: -2rpx;
  }
  
  .q-close {
    align-self: flex-end;
    margin-bottom: -2rpx;
  }
  
  .daily-quote {
    flex: 1;
    font-size: 30rpx;
    color: #2C1810;
    line-height: 1.85;
    font-weight: 500;
    padding: 0 4rpx;
    min-width: 0;
    word-break: break-word;
  }
  
  .daily-author {
    display: block;
    font-size: 22rpx;
    color: #8C7B61;
    text-align: right;
    margin-bottom: 14rpx;
    font-style: italic;
    letter-spacing: 1rpx;
  }
  
  .daily-sep {
    height: 1rpx;
    background: linear-gradient(90deg, transparent 0%, #C4882E 50%, transparent 100%);
    margin: 14rpx 0 18rpx;
    width: 100%;
  }
  
  .daily-translation {
    display: block;
    font-size: 26rpx;
    color: #5A4030;
    line-height: 1.85;
    margin-bottom: 16rpx;
    word-break: break-word;
  }
  
  .daily-insight-box {
    background: rgba(196,136,46,.09);
    border-left: 4rpx solid #C4882E;
    border-radius: 0 12rpx 12rpx 0;
    padding: 14rpx 18rpx;
    display: flex;
    align-items: flex-start;
    gap: 10rpx;
    margin-bottom: 16rpx;
    width: 100%;
    box-sizing: border-box;
  }
  
  .insight-dot {
    font-size: 20rpx;
    color: #C4882E;
    flex-shrink: 0;
    margin-top: 5rpx;
  }
  
  .insight-text {
    font-size: 25rpx;
    color: #4A3020;
    line-height: 1.75;
    min-width: 0;
    word-break: break-word;
  }
  
  /* Poetry banner */
  .poetry-card {
    position: relative;
    margin: 0 24rpx;
    border-radius: 22rpx;
    padding: 34rpx 28rpx;
    background: linear-gradient(135deg, #7A1E00 0%, #8B2500 55%, #B0601A 130%);
    box-shadow: 0 8rpx 28rpx rgba(139,37,0,.18), 0 2rpx 6rpx rgba(139,37,0,.08);
    display: flex;
    align-items: center;
    overflow: hidden;
    transition: opacity 0.3s ease, transform 0.3s ease;
    box-sizing: border-box;
    width: calc(100% - 48rpx);
  }

  .poetry-deco {
    position: absolute;
    right: 24rpx;
    top: 50%;
    transform: translateY(-50%);
    font-size: 170rpx;
    color: rgba(255,248,231,.08);
    font-weight: 900;
    line-height: 1;
    pointer-events: none;
  }

  .poetry-info {
    flex: 1;
    min-width: 0;
    position: relative;
    z-index: 1;
  }

  .poetry-title {
    display: block;
    font-size: 36rpx;
    font-weight: 700;
    color: #FFF8E7;
    letter-spacing: 4rpx;
    margin-bottom: 8rpx;
  }

  .poetry-sub {
    display: block;
    font-size: 22rpx;
    color: rgba(255,248,231,.7);
    margin-bottom: 18rpx;
    letter-spacing: 1rpx;
  }

  .poetry-tags {
    display: flex;
    gap: 12rpx;
    flex-wrap: wrap;
  }

  .poetry-tag {
    font-size: 20rpx;
    color: #FFD97D;
    border: 1rpx solid rgba(255,217,125,.5);
    border-radius: 22rpx;
    padding: 4rpx 16rpx;
    background: rgba(255,217,125,.08);
  }

  .poetry-arrow {
    position: relative;
    z-index: 1;
    font-size: 48rpx;
    color: rgba(255,248,231,.7);
    margin-left: 16rpx;
    flex-shrink: 0;
    font-weight: 300;
  }

  /* Solar term card */
  .solar-card {
    margin: 0 24rpx;
    background: #FFFBF0;
    border: 1rpx solid #E8C48A;
    border-radius: 24rpx;
    display: flex;
    overflow: hidden;
    box-shadow: 0 4rpx 16rpx rgba(139, 37, 0, 0.08);
    min-height: 230rpx;
    width: calc(100% - 48rpx);
    box-sizing: border-box;
  }

  .solar-left {
    width: 150rpx;
    background: linear-gradient(160deg, #3E7C4F, #2E6B3F);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24rpx 0;
    flex-shrink: 0;
  }

  .solar-left .sk-line {
    background: rgba(255, 248, 231, 0.25);
  }

  .solar-term {
    font-size: 40rpx;
    font-weight: 700;
    color: #FFF8E7;
    letter-spacing: 4rpx;
  }

  .solar-label {
    font-size: 20rpx;
    color: rgba(255, 248, 231, 0.75);
    margin-top: 8rpx;
    letter-spacing: 2rpx;
  }

  .solar-right {
    flex: 1;
    padding: 22rpx 24rpx;
    min-width: 0;
  }

  .solar-desc {
    display: block;
    font-size: 24rpx;
    color: #6B5B45;
    line-height: 1.6;
  }

  .solar-poem {
    margin-top: 14rpx;
    background: #F8EFD9;
    border-left: 6rpx solid #C4882E;
    border-radius: 0 12rpx 12rpx 0;
    padding: 14rpx 18rpx;
  }

  .solar-poem-title {
    display: block;
    font-size: 26rpx;
    font-weight: 600;
    color: #4A2E18;
  }

  .solar-poem-preview {
    display: block;
    font-size: 22rpx;
    color: #6B5B45;
    margin-top: 6rpx;
    line-height: 1.5;
  }

  .solar-go {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 10rpx;
    font-size: 22rpx;
    color: #8B2500;
  }

  .solar-go-arrow {
    font-size: 30rpx;
  }

  /* 节气卡片骨架辅助类 */
  .sk-circle {
    width: 88rpx;
    height: 88rpx;
    border-radius: 50%;
  }

  .sk-mt {
    margin-top: 16rpx;
  }

  .sk-h40 {
    height: 40rpx;
  }

  /* 本周最热门诗词 */
  .weekhot-card {
    margin: 0 24rpx;
    background: #FFFBF0;
    border: 1rpx solid #EDD9A3;
    border-radius: 22rpx;
    padding: 10rpx 24rpx 18rpx;
    box-shadow: 0 4rpx 16rpx rgba(139,37,0,.08);
    width: calc(100% - 48rpx);
    box-sizing: border-box;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .weekhot-row {
    display: flex;
    align-items: center;
    padding: 20rpx 0;
  }

  .weekhot-row + .weekhot-row {
    border-top: 1rpx dashed #E8D5A3;
  }

  .weekhot-rank {
    width: 44rpx;
    height: 44rpx;
    border-radius: 12rpx;
    background: linear-gradient(135deg, #F7C948, #C4882E);
    color: #FFF8E7;
    font-size: 26rpx;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-right: 20rpx;
    box-shadow: 0 2rpx 8rpx rgba(196,136,46,.35);
  }

  .weekhot-info {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: baseline;
    gap: 14rpx;
  }

  .weekhot-title {
    font-size: 29rpx;
    font-weight: 600;
    color: #2C1810;
    max-width: 62%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .weekhot-author {
    font-size: 22rpx;
    color: #8C7B61;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .weekhot-arrow {
    font-size: 32rpx;
    color: #C4A87C;
    margin-left: 12rpx;
    flex-shrink: 0;
  }

  .weekhot-more {
    text-align: center;
    font-size: 24rpx;
    color: #8B2500;
    padding-top: 16rpx;
    border-top: 1rpx dashed #E8D5A3;
    letter-spacing: 1rpx;
  }

  /* 连续学习7天 */
  .sevendays-card {
    margin: 0 24rpx;
    background: linear-gradient(135deg, #8B2500, #A23A12);
    border-radius: 22rpx;
    padding: 26rpx 24rpx;
    box-shadow: 0 6rpx 20rpx rgba(139,37,0,.18);
    width: calc(100% - 48rpx);
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 24rpx;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .sevendays-left {
    flex-shrink: 0;
    text-align: center;
    min-width: 120rpx;
  }

  .sevendays-streak {
    display: flex;
    align-items: baseline;
    justify-content: center;
  }

  .sevendays-num {
    font-size: 68rpx;
    font-weight: 800;
    color: #FFD97D;
    line-height: 1;
  }

  .sevendays-unit {
    font-size: 24rpx;
    color: rgba(255,248,231,.85);
    margin-left: 6rpx;
  }

  .sevendays-tip {
    display: block;
    font-size: 20rpx;
    color: rgba(255,248,231,.75);
    margin-top: 10rpx;
  }

  .sevendays-right {
    flex: 1;
    min-width: 0;
  }

  .sevendays-week {
    display: flex;
    justify-content: space-between;
  }

  .sevendays-day {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6rpx;
    padding: 10rpx 0;
    border-radius: 14rpx;
    width: 62rpx;
    background: rgba(255,248,231,.08);
    box-sizing: border-box;
  }

  .sevendays-day-label {
    font-size: 20rpx;
    color: rgba(255,248,231,.8);
  }

  .sevendays-day-num {
    font-size: 26rpx;
    font-weight: 700;
    color: #FFF8E7;
  }

  .sevendays-day-dot {
    font-size: 20rpx;
    color: #FFD97D;
    line-height: 1;
  }

  .sevendays-day.day-done {
    background: rgba(255,217,125,.22);
  }

  .sevendays-day.day-today {
    border: 2rpx solid #FFD97D;
  }

  .sevendays-more {
    text-align: right;
    font-size: 22rpx;
    color: #FFD97D;
    margin-top: 14rpx;
    letter-spacing: 1rpx;
  }

  /* Function grid */
  .func-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16rpx;
    padding: 0 24rpx;
    width: 100%;
    box-sizing: border-box;
  }
  
  .func-item {
    background: #FFFBF0;
    border-radius: 20rpx;
    padding: 28rpx 16rpx 22rpx;
    text-align: center;
    border: 1rpx solid #EDD9A3;
    box-shadow: 0 3rpx 12rpx rgba(139,37,0,.06);
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  
  .func-hover {
    opacity: 0.82 !important;
    transform: scale(0.98);
  }
  
  .func-icon-wrap {
    width: 96rpx;
    height: 96rpx;
    border-radius: 26rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16rpx;
    box-shadow: 0 5rpx 16rpx rgba(0,0,0,.15);
    flex-shrink: 0;
  }
  
  .func-char {
    font-size: 50rpx;
    color: #fff;
    font-weight: 700;
  }
  
  .func-name {
    font-size: 28rpx;
    color: #2C1810;
    font-weight: 600;
    margin-bottom: 5rpx;
    word-break: break-word;
  }
  
  .func-desc {
    font-size: 21rpx;
    color: #8C7B61;
    word-break: break-word;
  }
  
  /* 精选专题 */
  .topic-scroll {
    padding: 0 24rpx;
    white-space: nowrap;
    overflow: auto;
    -webkit-overflow-scrolling: touch;
    width: 100%;
    box-sizing: border-box;
  }

  .topic-row {
    display: inline-flex;
    gap: 18rpx;
    padding-bottom: 12rpx;
    min-width: max-content;
  }

  .topic-card {
    width: 300rpx;
    background: #FFFBF0;
    border: 1rpx solid #EDD9A3;
    border-radius: 20rpx;
    padding: 24rpx 22rpx;
    box-shadow: 0 3rpx 12rpx rgba(139,37,0,.06);
    display: inline-flex;
    align-items: center;
    gap: 16rpx;
    box-sizing: border-box;
    flex-shrink: 0;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .topic-badge {
    width: 76rpx;
    height: 76rpx;
    border-radius: 20rpx;
    color: #FFF8E7;
    font-size: 36rpx;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 4rpx 12rpx rgba(0,0,0,.18);
  }

  .topic-info {
    flex: 1;
    min-width: 0;
  }

  .topic-name {
    display: block;
    font-size: 28rpx;
    font-weight: 700;
    color: #2C1810;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .topic-sub {
    display: block;
    font-size: 20rpx;
    color: #8C7B61;
    margin-top: 6rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .topic-count {
    display: block;
    font-size: 19rpx;
    color: #C4882E;
    margin-top: 6rpx;
  }

  .topic-arrow {
    font-size: 32rpx;
    color: #C4A87C;
    flex-shrink: 0;
  }

  /* Hot topics */
  .hot-scroll {
    padding: 0 24rpx;
    white-space: nowrap;
    overflow: auto;
    -webkit-overflow-scrolling: touch;
    width: 100%;
    box-sizing: border-box;
  }
  
  .hot-row {
    display: inline-flex;
    gap: 14rpx;
    padding-bottom: 12rpx;
    min-width: max-content;
  }
  
  .hot-chip {
    display: inline-flex;
    align-items: center;
    gap: 8rpx;
    background: #FFFBF0;
    border: 1rpx solid #EDD9A3;
    border-radius: 32rpx;
    padding: 12rpx 24rpx;
    font-size: 25rpx;
    color: #4A3020;
    white-space: nowrap;
    box-shadow: 0 2rpx 8rpx rgba(196,136,46,.1);
    flex-shrink: 0;
    box-sizing: border-box;
  }
  
  .hot-hover {
    background: #FFF0CC !important;
  }
  
  .hot-fire {
    font-size: 24rpx;
    flex-shrink: 0;
  }
  
  .hot-text {
    font-size: 25rpx;
    color: #4A3020;
  }
  
  /* Categories */
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16rpx;
    padding: 0 24rpx 8rpx;
    width: 100%;
    box-sizing: border-box;
  }
  
  .cat-card:last-child:nth-child(odd) {
    grid-column: 1 / -1;
    width: calc(50% - 8rpx);
    box-sizing: border-box;
  }
  
  .cat-card {
    background: #FFFBF0;
    border-radius: 20rpx;
    padding: 24rpx 18rpx 20rpx;
    border: 1rpx solid #EDD9A3;
    box-shadow: 0 3rpx 10rpx rgba(139,37,0,.05);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    box-sizing: border-box;
    transition: background 0.3s ease, opacity 0.3s ease;
  }
  
  .cat-hover {
    background: #FFF5DC !important;
    opacity: 0.9;
  }
  
  .cat-icon-wrap {
    width: 72rpx;
    height: 72rpx;
    border-radius: 18rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14rpx;
    box-shadow: 0 3rpx 10rpx rgba(0,0,0,.12);
    flex-shrink: 0;
  }
  
  .cat-icon {
    font-size: 36rpx;
  }
  
  .cat-name {
    font-size: 28rpx;
    color: #2C1810;
    font-weight: 600;
    margin-bottom: 6rpx;
    word-break: break-word;
  }
  
  .cat-desc {
    font-size: 21rpx;
    color: #8C7B61;
    line-height: 1.5;
    word-break: break-word;
  }
  
  /* Footer */
  .home-footer {
    padding: 40rpx 0 22rpx;
    text-align: center;
    width: 100%;
    box-sizing: border-box;
  }
  
  .footer-txt {
    font-size: 22rpx;
    color: #B09070;
    letter-spacing: 2rpx;
  }
  
  .safe-bottom {
    height: env(safe-area-inset-bottom);
    min-height: 40rpx;
    background: #FDF6E3;
    width: 100%;
    box-sizing: border-box;
  }
  
  /* Poster modal */
  .poster-mask {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.75);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40rpx 30rpx;
    box-sizing: border-box;
  }
  
  .poster-container {
    background: #FDF6E3;
    border-radius: 24rpx;
    padding: 32rpx 28rpx 28rpx;
    width: 100%;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
  }
  
  .poster-close {
    position: absolute;
    top: 20rpx;
    right: 24rpx;
    font-size: 40rpx;
    color: #8C7B61;
    padding: 10rpx;
    z-index: 10;
  }
  
  .poster-title {
    font-size: 32rpx;
    font-weight: 700;
    color: #2C1810;
    margin-bottom: 8rpx;
    word-break: break-word;
  }
  
  .poster-sub {
    font-size: 22rpx;
    color: #8C7B61;
    margin-bottom: 24rpx;
    word-break: break-word;
  }
  
  .poster-canvas-wrap {
    width: 100%;
    position: relative;
    border-radius: 16rpx;
    overflow: hidden;
    background: #3D1A08;
    min-height: 300rpx;
    box-sizing: border-box;
  }
  
  .poster-loading {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(61,26,8,.9);
    z-index: 2;
    min-height: 300rpx;
    width: 100%;
    box-sizing: border-box;
  }
  
  @keyframes spin-slow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  
  .poster-loading-spin {
    font-size: 64rpx;
    color: #C4882E;
    display: inline-block;
    animation: spin-slow 1.2s linear infinite;
    margin-bottom: 16rpx;
  }
  
  .poster-loading-txt {
    font-size: 26rpx;
    color: rgba(253,246,227,.8);
  }
  
  .poster-canvas {
    width: 100%;
    height: auto;
    display: block;
    opacity: 0;
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: none;
  }
  
  .poster-preview {
    width: 100%;
    display: block;
    border-radius: 16rpx;
  }
  
  .poster-actions {
    display: flex;
    gap: 18rpx;
    margin-top: 24rpx;
    width: 100%;
    box-sizing: border-box;
  }
  
  .poster-btn {
    flex: 1;
    border-radius: 50rpx;
    padding: 22rpx 0;
    text-align: center;
    font-size: 26rpx;
    font-weight: 600;
    border: none;
    transition: opacity 0.3s ease;
    min-width: 0;
    box-sizing: border-box;
  }
  
  .btn-hover {
    opacity: 0.8 !important;
  }
  
  .poster-btn-save {
    background: linear-gradient(90deg, #8B2500, #C4882E);
    color: #FFF8E7;
  }
  
  .poster-btn-share {
    background: #FFFBF0;
    border: 2rpx solid #C4882E;
    color: #C4882E;
  }
  
  .poster-share-inner {
    width: 100%;
    height: 100%;
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    margin: 0 !important;
    font-size: 26rpx;
    font-weight: 600;
    color: #C4882E;
    line-height: 1;
    box-shadow: none !important;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .poster-share-inner::after {
    border: none !important;
  }
  
  .poster-hint {
    font-size: 22rpx;
    color: #8C7B61;
    margin-top: 14rpx;
  }
  