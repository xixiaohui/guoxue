/* pages/setting/index.wxss */
.page {
  background: #FDF6E3;
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 用户卡片 */
.user-card {
  background: linear-gradient(135deg, #8B2500, #C4882E);
  border-radius: 24rpx;
  padding: 36rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(139, 37, 0, 0.22);
}

.user-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 248, 231, 0.5);
  overflow: hidden;
  flex-shrink: 0;
  background: #FDF6E3;
}

.avatar {
  width: 100%;
  height: 100%;
}

/* 头像选择按钮（open-type="chooseAvatar"） */
.avatar-btn {
  position: relative;
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  border-radius: 50%;
  overflow: hidden;
  line-height: 1;
}
.avatar-btn::after {
  border: none;
}
.avatar-tip {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  font-size: 18rpx;
  line-height: 30rpx;
  color: #FFF8E7;
  background: rgba(0, 0, 0, 0.45);
  text-align: center;
}
.avatar-btn-hover {
  opacity: 0.85;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #FFF8E7;
}

/* 昵称输入框（input type="nickname"） */
.user-name-input {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #FFF8E7;
  height: 44rpx;
  line-height: 44rpx;
}
.user-name-placeholder {
  color: rgba(255, 248, 231, 0.55);
}

.user-desc {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 248, 231, 0.8);
  margin-top: 6rpx;
}

.btn-login {
  background: #FFF8E7;
  color: #8B2500;
  font-size: 26rpx;
  font-weight: 600;
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  white-space: nowrap;
}

.btn-logout {
  background: rgba(255, 248, 231, 0.2);
  color: #FFF8E7;
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  white-space: nowrap;
}

.btn-login-hover {
  opacity: 0.8;
  transform: scale(0.97);
}

/* 通用卡片 */
.section-card {
  background: #FFFBF0;
  border: 1rpx solid #E8D5A3;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(139, 37, 0, 0.05);
}

.section-title-inner {
  font-size: 28rpx;
  font-weight: 700;
  color: #4A2E18;
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
}

.card-hover {
  opacity: 0.8;
}

/* 行设置项 */
.setting-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
}

.setting-icon {
  font-size: 30rpx;
  width: 44rpx;
  text-align: center;
  flex-shrink: 0;
}

.setting-label {
  font-size: 28rpx;
  color: #4A2E18;
  flex: 1;
}

.setting-value {
  font-size: 24rpx;
  color: #8C7B61;
  padding-right: 12rpx;
}

.setting-arrow {
  font-size: 30rpx;
  color: #C4A87C;
  flex-shrink: 0;
}

/* 分割线 */
.setting-divider {
  height: 1rpx;
  background: #E8D5A3;
  margin: 8rpx 0;
}

/* 字体选择 */
.setting-block {
  padding: 14rpx 0;
}

.font-options,
.theme-options {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.font-opt {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  border: 2rpx solid #E8D5A3;
  font-size: 28rpx;
  color: #6B5B45;
  background: #FDF6E3;
}

.font-opt-active {
  border-color: #8B2500;
  color: #8B2500;
  background: #FFF3DC;
  font-weight: 700;
}

/* 正文字体选择（3 列网格，预览字 + 名称） */
.font-family-options {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.font-family-opt {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 0 12rpx;
}

.ff-preview-char {
  font-size: 44rpx;
  line-height: 1;
  color: #4A2E18;
}

.ff-preview-name {
  font-size: 22rpx;
  color: #8C7B61;
}

.font-opt-active .ff-preview-char {
  color: #8B2500;
}

.font-opt-active .ff-preview-name {
  color: #8B2500;
  font-weight: 700;
}

/* 各字体预览效果（真机按系统已装字体渲染，未安装时依次回退） */
.ff-preview-song .ff-preview-char { font-family: "Songti SC", "SimSun", "Noto Serif SC", serif; }
.ff-preview-kai .ff-preview-char { font-family: "Kaiti SC", "KaiTi", "STKaiti", "Noto Serif SC", serif; }
.ff-preview-fangsong .ff-preview-char { font-family: "FangSong SC", "FangSong", "STFangsong", serif; }
.ff-preview-hei .ff-preview-char { font-family: "Heiti SC", "SimHei", "Noto Sans SC", sans-serif; }
.ff-preview-xingkai .ff-preview-char { font-family: "Xingkai SC", "STXingkai", "Kaiti SC", serif; }

/* 主题选择 */
.theme-opt {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx 0;
  border-radius: 16rpx;
  border: 2rpx solid #E8D5A3;
  background: #FDF6E3;
}

.theme-opt-active {
  border-color: #8B2500;
  background: #FFF3DC;
}

.theme-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(0,0,0,0.08);
}

.theme-dot-classic {
  background: linear-gradient(135deg, #FDF6E3, #E8D5A3);
}

.theme-dot-dark {
  background: linear-gradient(135deg, #2A2218, #1A1410);
}

.theme-dot-green {
  background: linear-gradient(135deg, #F0F6EB, #B8D0A0);
}

.theme-name {
  font-size: 22rpx;
  color: #6B5B45;
}

.theme-opt-active .theme-name {
  color: #8B2500;
  font-weight: 700;
}

.opt-hover {
  opacity: 0.7;
  transform: scale(0.97);
}

.safe-bottom {
  height: env(safe-area-inset-bottom);
}
