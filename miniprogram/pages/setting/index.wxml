<view class="page">

  <!-- 用户卡片 -->
  <view class="user-card">
    <view class="user-row">
      <view class="avatar-wrap">
        <button wx:if="{{isLogin}}" class="avatar-btn" open-type="chooseAvatar"
          bind:chooseavatar="onChooseAvatar" hover-class="avatar-btn-hover" hover-stay-time="60">
          <image class="avatar" src="{{profile.avatarUrl || '/images/avatar.png'}}" mode="aspectFill" />
          <text class="avatar-tip">换头像</text>
        </button>
        <image wx:else class="avatar" src="/images/avatar.png" mode="aspectFill" />
      </view>
      <view class="user-info">
        <input wx:if="{{isLogin}}" class="user-name-input" type="nickname"
          value="{{profile.nickName}}" placeholder="点击设置昵称" placeholder-class="user-name-placeholder"
          bindblur="onNicknameInput" maxlength="20" />
        <text wx:else class="user-name">未登录</text>
        <text class="user-desc">{{isLogin ? '已登录，收藏可云端同步' : '登录后可同步收藏与点赞'}}</text>
      </view>
      <view class="user-action">
        <view class="btn-login" wx:if="{{!isLogin}}" bindtap="onLoginTap" hover-class="btn-login-hover" hover-stay-time="80">微信登录</view>
        <view class="btn-logout" wx:if="{{isLogin}}" bindtap="onLogoutTap" hover-class="btn-login-hover" hover-stay-time="80">退出</view>
      </view>
    </view>
  </view>

  <!-- 我的收藏 -->
  <view class="section-card" bindtap="goFavorite" hover-class="card-hover" hover-stay-time="80">
    <view class="setting-row">
      <text class="setting-icon">★</text>
      <text class="setting-label">我的收藏</text>
      <text class="setting-arrow">›</text>
    </view>
  </view>

  <!-- 通用设置 -->
  <view class="section-card">
    <view class="section-title-inner">通用设置</view>

    <view class="setting-block">
      <text class="setting-label">字体大小</text>
      <view class="font-options">
        <view class="font-opt {{fontSize === 'small' ? 'font-opt-active' : ''}}" data-size="small" bindtap="setFontSize" hover-class="opt-hover" hover-stay-time="60">小</view>
        <view class="font-opt {{fontSize === 'normal' ? 'font-opt-active' : ''}}" data-size="normal" bindtap="setFontSize" hover-class="opt-hover" hover-stay-time="60">标准</view>
        <view class="font-opt {{fontSize === 'large' ? 'font-opt-active' : ''}}" data-size="large" bindtap="setFontSize" hover-class="opt-hover" hover-stay-time="60">大</view>
      </view>
    </view>

    <view class="setting-divider"></view>

    <view class="setting-block">
      <text class="setting-label">正文字体</text>
      <view class="font-options font-family-options">
        <view class="font-opt font-family-opt ff-preview-default {{fontFamily === 'default' ? 'font-opt-active' : ''}}" data-font="default" bindtap="setFontFamily" hover-class="opt-hover" hover-stay-time="60">
          <text class="ff-preview-char">文</text>
          <text class="ff-preview-name">默认</text>
        </view>
        <view class="font-opt font-family-opt ff-preview-song {{fontFamily === 'song' ? 'font-opt-active' : ''}}" data-font="song" bindtap="setFontFamily" hover-class="opt-hover" hover-stay-time="60">
          <text class="ff-preview-char">文</text>
          <text class="ff-preview-name">宋体</text>
        </view>
        <view class="font-opt font-family-opt ff-preview-kai {{fontFamily === 'kai' ? 'font-opt-active' : ''}}" data-font="kai" bindtap="setFontFamily" hover-class="opt-hover" hover-stay-time="60">
          <text class="ff-preview-char">文</text>
          <text class="ff-preview-name">楷体</text>
        </view>
        <view class="font-opt font-family-opt ff-preview-fangsong {{fontFamily === 'fangsong' ? 'font-opt-active' : ''}}" data-font="fangsong" bindtap="setFontFamily" hover-class="opt-hover" hover-stay-time="60">
          <text class="ff-preview-char">文</text>
          <text class="ff-preview-name">仿宋</text>
        </view>
        <view class="font-opt font-family-opt ff-preview-hei {{fontFamily === 'hei' ? 'font-opt-active' : ''}}" data-font="hei" bindtap="setFontFamily" hover-class="opt-hover" hover-stay-time="60">
          <text class="ff-preview-char">文</text>
          <text class="ff-preview-name">黑体</text>
        </view>
        <view class="font-opt font-family-opt ff-preview-xingkai {{fontFamily === 'xingkai' ? 'font-opt-active' : ''}}" data-font="xingkai" bindtap="setFontFamily" hover-class="opt-hover" hover-stay-time="60">
          <text class="ff-preview-char">文</text>
          <text class="ff-preview-name">行楷</text>
        </view>
      </view>
    </view>

    <view class="setting-divider"></view>

    <view class="setting-block">
      <text class="setting-label">阅读主题</text>
      <view class="theme-options">
        <view class="theme-opt {{theme === 'classic' ? 'theme-opt-active' : ''}}" data-theme="classic" bindtap="setTheme" hover-class="opt-hover" hover-stay-time="60">
          <view class="theme-dot theme-dot-classic"></view>
          <text class="theme-name">古典</text>
        </view>
        <view class="theme-opt {{theme === 'dark' ? 'theme-opt-active' : ''}}" data-theme="dark" bindtap="setTheme" hover-class="opt-hover" hover-stay-time="60">
          <view class="theme-dot theme-dot-dark"></view>
          <text class="theme-name">夜间</text>
        </view>
        <view class="theme-opt {{theme === 'green' ? 'theme-opt-active' : ''}}" data-theme="green" bindtap="setTheme" hover-class="opt-hover" hover-stay-time="60">
          <view class="theme-dot theme-dot-green"></view>
          <text class="theme-name">护眼</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 数据管理 -->
  <view class="section-card">
    <view class="section-title-inner">数据管理</view>

    <view class="setting-row" bindtap="syncFavorites" hover-class="card-hover" hover-stay-time="80">
      <text class="setting-icon">↻</text>
      <text class="setting-label">同步收藏到云端</text>
      <text class="setting-arrow">›</text>
    </view>

    <view class="setting-divider"></view>

    <view class="setting-row" bindtap="clearCache" hover-class="card-hover" hover-stay-time="80">
      <text class="setting-icon">🗑</text>
      <text class="setting-label">清除本地缓存</text>
      <text class="setting-value">{{cacheSize}}</text>
      <text class="setting-arrow">›</text>
    </view>
  </view>

  <!-- 关于 -->
  <view class="section-card">
    <view class="setting-row" bindtap="checkUpdate" hover-class="card-hover" hover-stay-time="80">
      <text class="setting-icon">⟳</text>
      <text class="setting-label">检查更新</text>
      <text class="setting-value">v{{version}}</text>
      <text class="setting-arrow">›</text>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>
