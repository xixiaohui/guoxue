<!--pages/mid_autumn/index.wxml - 中秋诗词专题-->
<view class="page {{fontFamilyClass}}">

  <!-- 页头（月夜金配色） -->
  <view class="page-header">
    <view class="header-inner">
      <view class="header-badge">{{badge}}</view>
      <view class="header-text">
        <text class="header-title">{{title}}</text>
        <text class="header-sub">{{subtitle}}</text>
      </view>
    </view>
  </view>

  <!-- 专题简介 -->
  <view class="intro-card">
    <text class="intro-text">{{desc}}</text>
    <text class="intro-count">共收录 {{items.length}} 篇</text>
  </view>

  <!-- 列表 -->
  <view class="list">
    <view class="card poem-card" wx:for="{{items}}" wx:key="id" bindtap="goDetail"
      data-poem="{{item}}" hover-class="card-hover" hover-stay-time="80">
      <view class="card-top">
        <text class="card-title">{{item.title || '无题'}}</text>
        <text class="card-type" wx:if="{{item.type}}">{{item.type}}</text>
      </view>
      <text class="card-author">{{item.dynasty ? item.dynasty + ' · ' : ''}}{{item.author || '佚名'}}</text>
      <view class="card-body">
        <text class="card-line" wx:for="{{item.lines}}" wx:for-item="line" wx:key="*this">{{line}}</text>
      </view>
      <view class="card-appreciation" wx:if="{{item.appreciation}}">
        <text class="card-ap-label">赏析</text>
        <text class="card-ap-text">{{item.appreciation}}</text>
      </view>
      <text class="card-go">查看详情 ›</text>
    </view>
  </view>

  <view class="footer">内容为公共领域经典诗文 · 超然古诗词</view>
</view>
