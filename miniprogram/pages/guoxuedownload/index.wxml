<view class="{{fontFamilyClass}}">

  <!-- 朋友圈单页模式：pdf 组件与激励视频广告被禁用，展示引导说明 -->
  <view class="single-page-tip" wx:if="{{isSinglePage}}">
    <text class="single-page-tip-icon">📄</text>
    <text class="single-page-tip-title">文库预览不可用</text>
    <text class="single-page-tip-desc">当前为朋友圈分享预览，PDF 在线阅读与下载需要完整小程序环境，打开小程序即可使用</text>
  </view>

  <view class="section" wx:if="{{!isSinglePage}}">
   
    <view class="page">
      <pdf-file-service
        title="国学PDF文库"
        apiUrl="https://www.readmeet.club/api/files"
        enableRewardAd="{{true}}"
        rewardAdUnitId="adunit-513a37c7d48cdf7f"
        rewardForCachedOpen="{{false}}"
        adFailBehavior="block"
        openAdConfirmContent="观看完整广告后可打开文档"
        downloadAdConfirmContent="观看完整广告后可下载文档"
        bind:loaded="onPdfLoaded"
        bind:opened="onPdfOpened"
        bind:downloaded="onPdfDownloaded"
        bind:cachedeleted="onPdfCacheDeleted"
        bind:adload="onAdLoad"
        bind:adreward="onAdReward"
        bind:adcancel="onAdCancel"
        bind:aderror="onAdError"
        bind:error="onPdfError"
      />
    </view>
  </view>

</view>