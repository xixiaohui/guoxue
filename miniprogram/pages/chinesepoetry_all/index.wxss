/* pages/chinesepoetry_all/index.wxss - 诗词/诗人/朝代/体裁 全部列表样式 */
.page {
  background: #F5EDD6;
  min-height: 100vh;
  width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
  padding-bottom: 60rpx;
}

/* ── 页头 ─────────────────────────────── */
.page-header {
  background: linear-gradient(160deg, #6B1F0A 0%, #8B2500 55%, #A8381A 100%);
  padding: 40rpx 30rpx 44rpx;
  width: 100%;
  box-sizing: border-box;
}

.header-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #FFF8E7;
  letter-spacing: 6rpx;
}

.header-sub {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 248, 231, 0.65);
  margin-top: 8rpx;
  letter-spacing: 4rpx;
}

/* ── 列表容器 ─────────────────────────── */
.list {
  margin: 24rpx 24rpx 0;
}

.list-loading {
  margin: 24rpx 24rpx 0;
  background: #FFFBF0;
  border: 1rpx dashed #D8C08A;
  border-radius: 16rpx;
  padding: 40rpx;
  text-align: center;
}

.list-loading-text {
  font-size: 24rpx;
  color: #8C7B61;
}

.empty-tip {
  margin: 24rpx 24rpx 0;
  background: #FFFBF0;
  border: 1rpx dashed #D8C08A;
  border-radius: 16rpx;
  padding: 48rpx 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #8C7B61;
}

/* ── 诗词卡片 ─────────────────────────── */
.poem-card {
  background: #FFFBF0;
  border: 1rpx solid #E8D5A3;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 2rpx 10rpx rgba(139, 37, 0, 0.05);
}

.card-hover {
  background: #F8EFD9 !important;
  transform: translateY(2rpx);
}

.poem-card-top {
  display: flex;
  align-items: center;
}

.poem-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A2E18;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.poem-type {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #8B2500;
  background: #F8EFD9;
  border: 1rpx solid #E0C890;
  border-radius: 18rpx;
  padding: 2rpx 14rpx;
  margin-left: 12rpx;
}

.poem-author {
  display: block;
  font-size: 24rpx;
  color: #C4882E;
  margin-top: 8rpx;
}

.poem-preview {
  display: block;
  font-size: 24rpx;
  color: #6B5B45;
  margin-top: 10rpx;
  line-height: 1.6;
}

/* ── 诗人行 ─────────────────────────── */
.author-item {
  display: flex;
  align-items: center;
  background: #FFFBF0;
  border: 1rpx solid #E8D5A3;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 2rpx 10rpx rgba(139, 37, 0, 0.05);
}

.author-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #C4882E, #8B2500);
  color: #FFF8E7;
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.author-info {
  flex: 1;
  margin-left: 22rpx;
  min-width: 0;
}

.author-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #4A2E18;
}

.author-meta {
  display: block;
  font-size: 22rpx;
  color: #8C7B61;
  margin-top: 6rpx;
}

.row-arrow {
  font-size: 40rpx;
  color: #C4A87C;
  margin-left: 12rpx;
}

/* ── 朝代/体裁行 ─────────────────────── */
.cat-item {
  display: flex;
  align-items: center;
  background: #FFFBF0;
  border: 1rpx solid #E8D5A3;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 2rpx 10rpx rgba(139, 37, 0, 0.05);
}

.cat-left {
  flex: 1;
  min-width: 0;
}

.cat-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #4A2E18;
  letter-spacing: 2rpx;
}

.cat-desc {
  display: block;
  font-size: 20rpx;
  color: #8C7B61;
  margin-top: 6rpx;
}

.cat-nums {
  display: flex;
  align-items: center;
  gap: 26rpx;
  flex-shrink: 0;
}

.cat-num-block {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.cat-num {
  font-size: 28rpx;
  font-weight: 700;
  color: #8B2500;
}

.cat-num-label {
  font-size: 20rpx;
  color: #A08C6B;
  margin-top: 4rpx;
}

/* ── 分页状态 ─────────────────────────── */
.load-more {
  background: #FFFBF0;
  border: 1rpx solid #E8D5A3;
  border-radius: 16rpx;
  padding: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #8B2500;
}

.list-end {
  padding: 26rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: #A08C6B;
  letter-spacing: 2rpx;
}

/* ── 页脚 ─────────────────────────────── */
.footer {
  text-align: center;
  font-size: 20rpx;
  color: #A08C6B;
  padding: 36rpx 0 24rpx;
  letter-spacing: 2rpx;
}
