<!--pages/feihua/index.wxml - 飞花令（单人对诗库）-->
<view class="page {{fontFamilyClass}}">

  <!-- 朋友圈单页模式提示 -->
  <view class="single-page-tip" wx:if="{{isSinglePage}}">
    <text class="single-page-tip-text">当前为朋友圈分享预览，可直接对诗，打开小程序体验完整功能</text>
  </view>

  <!-- ── 选字阶段 ────────────────────────── -->
  <block wx:if="{{stage === 'pick'}}">
    <view class="hero-card">
      <text class="hero-deco">令</text>
      <text class="hero-title">飞花令</text>
      <text class="hero-sub">以诗会友 · 一字千年</text>
    </view>

    <!-- 玩法模式 -->
    <view class="section-card">
      <view class="section-head">
        <view class="label-bar"></view>
        <text class="section-label">选择玩法</text>
      </view>
      <view class="mode-row">
        <view class="mode-item {{mode === 'free' ? 'mode-active' : ''}}" bindtap="switchMode" data-mode="free"
          hover-class="mode-hover" hover-stay-time="80">
          <text class="mode-name">自由飞花</text>
          <text class="mode-desc">诗句含主题字即可</text>
        </view>
        <view class="mode-item {{mode === 'strict' ? 'mode-active' : ''}}" bindtap="switchMode" data-mode="strict"
          hover-class="mode-hover" hover-stay-time="80">
          <text class="mode-name">行飞花令</text>
          <text class="mode-desc">第 N 轮字居句第 N 位</text>
        </view>
      </view>
    </view>

    <!-- 主题字 -->
    <view class="section-card">
      <view class="section-head">
        <view class="label-bar"></view>
        <text class="section-label">选择主题字</text>
      </view>
      <view class="word-grid">
        <view class="word-item {{word === item ? 'word-active' : ''}}" wx:for="{{words}}" wx:key="*this"
          bindtap="pickWord" data-word="{{item}}" hover-class="word-hover" hover-stay-time="80">{{item}}</view>
      </view>
      <view class="custom-row">
        <input class="custom-input" value="{{customWord}}" bindinput="onCustomInput" maxlength="4"
          placeholder="或输入一个字，如 梅、竹、鹤" placeholder-class="custom-placeholder" confirm-type="done" />
        <view class="custom-btn" bindtap="startGame" hover-class="btn-hover" hover-stay-time="80">开局</view>
      </view>
      <view class="current-word" wx:if="{{word}}">当前主题字：<text class="current-word-char">{{word}}</text></view>
    </view>

    <!-- 玩法说明 -->
    <view class="section-card">
      <view class="rule-toggle" bindtap="toggleRule" hover-class="mode-hover" hover-stay-time="80">
        <text class="rule-arrow">{{ruleOpen ? '▼' : '▶'}}</text>
        <text class="rule-toggle-text">玩法说明</text>
      </view>
      <view class="rule-body" wx:if="{{ruleOpen}}">
        <view class="rule-line"><text class="rule-dot">·</text>自由飞花：系统随机出含主题字的诗句，赏诗续令，不限位置。</view>
        <view class="rule-line"><text class="rule-dot">·</text>行飞花令：第 1 轮字居句首，第 2 轮居第 2 位……第 7 轮居第 7 位，第 8 轮回到第 1 位循环。</view>
        <view class="rule-line"><text class="rule-dot">·</text>行令位置按诗句小句计，标点忽略；同字同句本局不重复出现。</view>
        <view class="rule-line"><text class="rule-dot">·</text>若某轮无合位名句，将自动放宽为含字即可，不影响续令。</view>
        <view class="rule-line"><text class="rule-dot">·</text>可随时结束，按完成轮数结算评语，看看你能拿到几级称号。</view>
      </view>
    </view>
  </block>

  <!-- ── 对局阶段 ────────────────────────── -->
  <block wx:elif="{{stage === 'play'}}">
    <view class="play-head">
      <view class="play-word">{{word}}</view>
      <view class="play-meta">
        <view class="round-badge">第 {{round + 1}} 轮</view>
        <text class="mode-tag">{{modeName}}</text>
      </view>
    </view>

    <view class="pos-tip" wx:if="{{mode === 'strict'}}">
      本令「<text class="pos-word">{{word}}</text>」须居句第 {{targetPos}} 位
    </view>

    <!-- 诗句卡 -->
    <view class="poem-card {{loading ? 'poem-fade' : ''}}" wx:if="{{poem}}">
      <view class="poem-quote-mark">「</view>
      <view class="poem-chars">
        <text class="poem-char {{item.hit ? 'char-hit' : ''}}" wx:for="{{poem.chars}}" wx:key="index">{{item.ch}}</text>
      </view>
      <view class="poem-quote-mark poem-quote-close">」</view>
      <view class="poem-meta">
        <text class="poem-title">{{poem.title ? '《' + poem.title + '》' : '无名篇'}}</text>
        <text class="poem-author" wx:if="{{poem.author}}">{{poem.dynasty}} · {{poem.author}}</text>
      </view>
      <view class="poem-view" bindtap="viewFullPoem" hover-class="mode-hover" hover-stay-time="80">
        <text>查看全诗</text>
        <text class="poem-view-arrow">›</text>
      </view>
    </view>

    <view class="poem-loading" wx:if="{{loading && !poem}}">
      <view class="poem-loading-spin">⟳</view>
      <text class="poem-loading-text">正在出题…</text>
    </view>

    <view class="empty-tip" wx:if="{{error}}">{{error}}</view>

    <!-- 行令放宽提示（分层原因） -->
    <view class="relaxed-tip" wx:if="{{relaxed}}">
      <block wx:if="{{relaxReason === 'short'}}">本令「{{word}}」须居第 {{targetPos}} 位，而本句最长 {{relaxMaxLen}} 字，无法合位，已放宽为含字即可</block>
      <block wx:else>暂未寻得「{{word}}」居第 {{targetPos}} 位的名句，已放宽为含字即可</block>
    </view>

    <!-- 操作 -->
    <view class="play-actions">
      <view class="btn btn-next {{loading ? 'btn-disabled' : ''}}" bindtap="nextRound" hover-class="btn-hover" hover-stay-time="80">
        {{round === 0 ? '开始对诗' : '下一轮 ›'}}
      </view>
      <view class="btn btn-end {{loading ? 'btn-disabled' : ''}}" bindtap="endGame" hover-class="btn-hover" hover-stay-time="80">结束</view>
    </view>

    <view class="play-stats">已赏 {{totalShown}} 句 · {{round}} 轮</view>
  </block>

  <!-- ── 结算阶段 ────────────────────────── -->
  <block wx:elif="{{stage === 'result'}}">
    <view class="result-card">
      <text class="result-deco">令</text>
      <text class="result-label">本次飞花令</text>
      <view class="result-word">{{result.word}}</view>
      <view class="result-rows">
        <view class="result-row">
          <text class="result-row-label">完成轮数</text>
          <text class="result-num">{{result.rounds}}</text>
        </view>
        <view class="result-row">
          <text class="result-row-label">赏诗</text>
          <text class="result-num">{{result.shown}}</text>
        </view>
        <view class="result-row">
          <text class="result-row-label">评语</text>
          <text class="result-tag">{{result.comment}}</text>
        </view>
      </view>
      <view class="result-actions">
        <view class="btn btn-next" bindtap="restart" hover-class="btn-hover" hover-stay-time="80">再来一局</view>
        <view class="btn btn-end" bindtap="changeWord" hover-class="btn-hover" hover-stay-time="80">换个字</view>
      </view>
    </view>
  </block>

  <view class="safe-bottom"></view>
</view>
