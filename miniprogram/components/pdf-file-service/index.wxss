.pdf-wrap {
  padding: 24rpx;
  box-sizing: border-box;
}

.pdf-head {
  margin-bottom: 24rpx;
}

.pdf-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2329;
}

.pdf-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #86909c;
}

.state-box {
  padding: 60rpx 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  text-align: center;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.04);
}

.state-text {
  color: #86909c;
  font-size: 28rpx;
}

.retry-btn {
  margin-top: 24rpx;
  background: #1677ff;
  color: #fff;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.pdf-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.05);
}

.pdf-main {
  display: flex;
  align-items: flex-start;
}

.pdf-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #ff6b6b, #d9363e);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.pdf-info {
  flex: 1;
  min-width: 0;
}

.pdf-name {
  font-size: 30rpx;
  color: #1f2329;
  font-weight: 600;
  line-height: 1.4;
  word-break: break-all;
}

.pdf-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #86909c;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.dot {
  margin: 0 10rpx;
}

.downloaded-tag {
  display: inline-block;
  margin-top: 12rpx;
  padding: 6rpx 16rpx;
  background: #e8f7ee;
  color: #00a870;
  font-size: 22rpx;
  border-radius: 999rpx;
}

.progress-wrap {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
}

.progress-bar {
  flex: 1;
  height: 12rpx;
  background: #f2f3f5;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background: linear-gradient(90deg, #1677ff, #69b1ff);
  border-radius: 999rpx;
}

.progress-text {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #4e5969;
}

.pdf-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.btn {
  flex: 1;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.btn::after {
  border: none;
}

.btn-open {
  background: #1677ff;
  color: #fff;
}

.btn-download {
  background: #f2f3f5;
  color: #1f2329;
}
