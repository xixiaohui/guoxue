.pdf-page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f7f9fc 0%, #f3f5f8 100%);
}

/* 顶部 */
.page-header {
  margin-bottom: 20rpx;
  padding: 8rpx 4rpx 12rpx;
}

.page-title {
  font-size: 42rpx;
  line-height: 1.4;
  font-weight: 700;
  color: #1f2329;
}

.page-desc {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #86909c;
}

.page-count {
  margin-top: 14rpx;
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #edf2ff;
  color: #3b82f6;
  font-size: 22rpx;
  font-weight: 600;
}

/* 搜索栏 */
.search-bar {
  margin-bottom: 18rpx;
}

.search-box {
  display: flex;
  align-items: center;
  height: 84rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 0 24rpx;
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.05);
}

.search-icon {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #94a3b8;
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
}

.search-icon::after {
  content: '';
  position: absolute;
  width: 12rpx;
  height: 4rpx;
  background: #94a3b8;
  right: -10rpx;
  bottom: -4rpx;
  transform: rotate(45deg);
  border-radius: 999rpx;
}

.search-input {
  flex: 1;
  margin-left: 20rpx;
  font-size: 28rpx;
  color: #1f2329;
}

.search-clear {
  margin-left: 16rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #f2f3f5;
  color: #86909c;
  font-size: 28rpx;
}

/* 筛选 tabs */
.filter-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  background: #ffffff;
  color: #4e5969;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.04);
}

.filter-tab.active {
  background: linear-gradient(135deg, #1677ff, #4096ff);
  color: #ffffff;
  box-shadow: 0 10rpx 22rpx rgba(22, 119, 255, 0.16);
}

/* 状态卡 */
.state-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 60rpx 32rpx;
  text-align: center;
  box-shadow: 0 16rpx 40rpx rgba(15, 23, 42, 0.06);
}

.state-icon {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #dbeafe, #eff6ff);
}

.loading-icon {
  position: relative;
}

.loading-icon::after {
  content: '';
  position: absolute;
  left: 24rpx;
  top: 24rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 6rpx solid #93c5fd;
  border-top-color: #2563eb;
  box-sizing: border-box;
}

.empty-icon {
  position: relative;
}

.empty-icon::after {
  content: '';
  position: absolute;
  left: 26rpx;
  top: 22rpx;
  width: 44rpx;
  height: 52rpx;
  border-radius: 10rpx;
  background: #93c5fd;
}

.state-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2329;
}

.state-desc {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #86909c;
}

.state-btn {
  margin-top: 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #1677ff, #4096ff);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.state-btn::after {
  border: none;
}

.secondary-btn {
  background: #f2f3f5;
  color: #1f2329;
}

/* 文档卡片 */
.doc-card {
  margin-bottom: 22rpx;
}

.doc-card-inner {
  display: flex;
  align-items: flex-start;
  padding: 26rpx;
  border-radius: 32rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fcfcfd 100%);
  box-shadow:
    0 14rpx 34rpx rgba(15, 23, 42, 0.06),
    0 2rpx 8rpx rgba(15, 23, 42, 0.03);
  border: 1rpx solid rgba(15, 23, 42, 0.04);
}

.doc-left {
  flex-shrink: 0;
  margin-right: 22rpx;
}

.doc-cover {
  width: 104rpx;
  height: 132rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #ff6b6b 0%, #cf1322 100%);
  position: relative;
  overflow: hidden;
  box-shadow: 0 12rpx 24rpx rgba(207, 19, 34, 0.18);
}

.doc-cover-top {
  position: absolute;
  right: 0;
  top: 0;
  width: 30rpx;
  height: 30rpx;
  background: rgba(255, 255, 255, 0.25);
  clip-path: polygon(0 0, 100% 0, 100% 100%);
}

.doc-cover-text {
  margin-top: 22rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.doc-cover-lines {
  margin-top: 16rpx;
  padding: 0 18rpx;
}

.cover-line {
  height: 6rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.65);
  margin-bottom: 10rpx;
}

.cover-line.short {
  width: 60%;
}

.doc-body {
  flex: 1;
  min-width: 0;
}

.doc-title-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.doc-title {
  flex: 1;
  font-size: 31rpx;
  line-height: 1.5;
  font-weight: 700;
  color: #1f2329;
  word-break: break-all;
}

.status-badge {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 700;
}

.status-badge.success {
  background: #e8f7ee;
  color: #00a870;
}

.status-badge.warning {
  background: #fff7e8;
  color: #d46b08;
}

.doc-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.meta-chip {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
}

.meta-label {
  font-size: 22rpx;
  color: #86909c;
}

.meta-value {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #4e5969;
  font-weight: 600;
}

.doc-tip {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.success-tip {
  background: linear-gradient(180deg, #f0fdf4 0%, #ecfdf3 100%);
  color: #15803d;
}

.warning-tip {
  background: linear-gradient(180deg, #fffaf0 0%, #fff7e8 100%);
  color: #b45309;
}

/* 下载进度 */
.download-panel {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 20rpx;
  background: #f8fafc;
}

.download-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.download-label {
  font-size: 23rpx;
  color: #4e5969;
  font-weight: 600;
}

.download-percent {
  font-size: 23rpx;
  color: #1677ff;
  font-weight: 700;
}

.download-bar {
  height: 12rpx;
  border-radius: 999rpx;
  background: #e5e7eb;
  overflow: hidden;
}

.download-bar-inner {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #1677ff, #69b1ff);
}

/* 按钮 */
.doc-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 22rpx;
}

.action-btn {
  flex: 1;
  min-width: 190rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 700;
  padding: 0 24rpx;
  line-height: 2.45;
}

.action-btn::after {
  border: none;
}

.action-btn.primary {
  background: linear-gradient(135deg, #1677ff, #4096ff);
  color: #ffffff;
  box-shadow: 0 10rpx 20rpx rgba(22, 119, 255, 0.18);
}

.action-btn.secondary {
  background: #f2f3f5;
  color: #1f2329;
}

.action-btn.ghost-danger {
  background: #fff1f0;
  color: #cf1322;
}

@media (max-width: 375px) {
  .doc-title-row {
    flex-direction: column;
    align-items: flex-start;
  }

  .status-badge {
    margin-top: 4rpx;
  }

  .filter-tabs {
    gap: 12rpx;
  }
}
